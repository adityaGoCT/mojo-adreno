#version 450
// AdrenoBLAS pack kernel: K-minor source S[X, K] (row-major: A stored [M,K] or B stored [N,K]) -> K-minor tiles:
//   element (x, k) at ((x / 64) * (K / 16) + k / 16) * 1024 + (x % 64) * 16 + k % 16
// i.e. 64 x 16 tiles with K contiguous inside (A tiles row-major, B tiles column-major), K tiles adjacent within
// each 64-wide panel. Each lane of the matrix unit then loads its 16 operand halves as two 16-byte vectors.
// A plain re-tiling copy, 128 bits per thread. A workgroup copies a 32-row x 64-K block (workgroups K/64 x X/32):
// 8 lanes read a 128-byte row segment, and a 64-lane subgroup (8 rows) writes four 256-byte runs, one per tile.
// (Walking K along whole rows instead scattered 32-byte writes over K/16 tiles: 28 GB/s at K = 8192.)
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8, local_size_y = 32) in;
layout(constant_id = 0) const uint X = 64u;
layout(constant_id = 1) const uint K = 64u;
layout(std430, binding = 0) readonly buffer S4 { uvec4 s4[]; };
layout(std430, binding = 2) writeonly buffer D4 { uvec4 d4[]; };
void main() {
  uint x = gl_WorkGroupID.y * 32u + gl_LocalInvocationID.y;
  uint k = gl_WorkGroupID.x * 64u + gl_LocalInvocationID.x * 8u;
  d4[(((x / 64u) * (K / 16u) + k / 16u) * 1024u + (x % 64u) * 16u + k % 16u) / 8u] = s4[(x * K + k) / 8u];
}
