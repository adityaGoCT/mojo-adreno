#version 450
// AdrenoBLAS pack: ggml block_q4_0 rows ({fp16 d; uint8 qs[16]}, 18 bytes, q[j] = qs[j] & 15, q[j + 16] = qs[j] >> 4)
// of an [N, K] weight -> AdrenoBLAS's Q4_0 layout (gen_q4.py; same size). Invocation per (64-row panel p, 32-deep
// block kb, row n % 64), rows fastest, so the writes of a subgroup are contiguous. N multiple of 64, K of 32.
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint N = 64u;
layout(constant_id = 1) const uint UNUSED = 0u;
layout(constant_id = 2) const uint K = 32u;
layout(std430, binding = 0) readonly buffer S { uint16_t s[]; };
layout(std430, binding = 2) writeonly buffer DQ { uvec2 dq[]; };
layout(std430, binding = 2) writeonly buffer DS { uint16_t ds[]; };
void main() {
  uint KB = K / 32u, t = gl_GlobalInvocationID.x;
  if (t >= N * KB) return;
  uint lane = t % 64u, rest = t / 64u, kb = rest % KB, p = rest / KB, n = p * 64u + lane;
  uint b = (n * KB + kb) * 9u;  // the block in 16-bit words: d, then qs[0..15] as 8 words
  uint q[32];
  for (uint j = 0u; j < 8u; ++j) {
    uint w = uint(s[b + 1u + j]), lo = w & 255u, hi = w >> 8u;
    q[2u * j] = lo & 15u, q[2u * j + 16u] = lo >> 4u;
    q[2u * j + 1u] = hi & 15u, q[2u * j + 17u] = hi >> 4u;
  }
  for (uint h = 0u; h < 2u; ++h) {
    uint w0 = 0u, w1 = 0u;
    for (uint i = 0u; i < 4u; ++i) {
      w0 |= q[16u * h + 2u * i] << (4u * i) | q[16u * h + 2u * i + 1u] << (16u + 4u * i);
      w1 |= q[16u * h + 8u + 2u * i] << (4u * i) | q[16u * h + 8u + 2u * i + 1u] << (16u + 4u * i);
    }
    dq[((p * KB + kb) * 2u + h) * 64u + lane] = uvec2(w0, w1);
  }
  ds[N * K / 4u + (p * KB + kb) * 64u + lane] = s[b];
}
