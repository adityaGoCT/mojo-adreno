+// whether AdrenoBLAS takes a matmul on an eligible weight (the original is gone after an in-place repack)
+static bool ggml_vk_ablas_takes(const ggml_tensor * w, int64_t m) {
+    return ggml_vk_ablas_inplace(w) || ggml_vk_ablas_mode() == ABLAS_VERIFY || m >= ggml_vk_ablas_min_m();
