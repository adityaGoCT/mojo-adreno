+#ifdef GGML_VULKAN_ADRENOBLAS
+// AdrenoBLAS path for MUL_MAT on a model weight ("blk.*.weight", fp16 or Q4_0, 2D, both dims multiples of 64):
+// the first time a weight is used it is repacked into AdrenoBLAS's tile format, in place (same size) or into a copy
+// (GGML_VK_ABLAS_MODE above); the fp32 activations are packed to fp16 tiles in prealloc_y, and AdrenoBLAS writes the
+// fp32 result. Matmuls that come here are not fused into ggml's kernels (ggml_vk_can_fuse).
+static bool ggml_vk_ablas_weight(const ggml_backend_vk_context * ctx, const ggml_tensor * w) {
+    if (!ctx->device->ablas || !w || (w->type != GGML_TYPE_F16 && w->type != GGML_TYPE_Q4_0)) {
+        return false;
+    }
+    const size_t n = strlen(w->name);
+    if (strncmp(w->name, "blk.", 4) != 0 || n < 7 || strcmp(w->name + n - 7, ".weight") != 0) {
+        return false;
+    }
+    static const char * filter = getenv("GGML_VK_ABLAS_FILTER");  // debugging: only weights whose name contains this
+    if (filter && !strstr(w->name, filter)) {
+        return false;
+    }
+    return w->ne[2] == 1 && w->ne[3] == 1 && w->ne[0] % 64 == 0 && w->ne[1] % 64 == 0 && ggml_is_contiguous(w) &&
+           w->view_src == nullptr && w->buffer && !ggml_backend_buffer_is_host(w->buffer);
+}
