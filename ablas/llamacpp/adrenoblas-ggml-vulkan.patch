+// GGML_VK_ABLAS_MODE:
+//   auto (default): Q4_0 weights get a repacked copy, so matmuls with fewer than GGML_VK_ABLAS_MIN_M (default 9)
+//                   rows, i.e. decode, keep ggml's mat-vec kernels on the original; F16 weights are repacked in
+//                   place (a copy would double 6 GB), so every matmul on them goes to AdrenoBLAS
+//   inplace:        every weight repacked in its own memory; copy: every weight gets a repacked copy
+//   verify:         copy, and AdrenoBLAS's result compared with ggml's after each graph (every M)
+enum { ABLAS_INPLACE = 0, ABLAS_COPY = 1, ABLAS_VERIFY = 2, ABLAS_AUTO = 3 };
+static int ggml_vk_ablas_mode() {
+    static int mode = -1;
+    if (mode < 0) {
+        const char * e = getenv("GGML_VK_ABLAS_MODE");
+        mode = !e ? ABLAS_AUTO : !strcmp(e, "inplace") ? ABLAS_INPLACE : !strcmp(e, "copy") ? ABLAS_COPY :
+               !strcmp(e, "verify") ? ABLAS_VERIFY : ABLAS_AUTO;
+    }
+    return mode;
+}
+static bool ggml_vk_ablas_inplace(const ggml_tensor * w) {
+    return ggml_vk_ablas_mode() == ABLAS_INPLACE || (ggml_vk_ablas_mode() == ABLAS_AUTO && w->type == GGML_TYPE_F16);
+}
+static int64_t ggml_vk_ablas_min_m() {
+    static int64_t m = -1;
+    if (m < 0) {
+        const char * e = getenv("GGML_VK_ABLAS_MIN_M");
+        m = e ? atoll(e) : 9;
+    }
+    return m;
+}
+// whether AdrenoBLAS takes a matmul on an eligible weight (the original is gone after an in-place repack)
+static bool ggml_vk_ablas_takes(const ggml_tensor * w, int64_t m) {
+    return ggml_vk_ablas_inplace(w) || ggml_vk_ablas_mode() == ABLAS_VERIFY || m >= ggml_vk_ablas_min_m();
+}
+static vk_pipeline_struct * ggml_vk_ablas_packed_marker() {  // prealloc_y holds AdrenoBLAS's packed tiles of a tensor
+    static char marker;
