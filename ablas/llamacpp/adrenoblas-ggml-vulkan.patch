+// GGML_VK_ABLAS_SELFTEST=1: one Q4_0 GEMM through AdrenoBLAS on this device, outside any graph, vs the CPU
+static void ggml_vk_ablas_selftest(vk_device & dev) {
+    const uint32_t M = 6, N = 1024, K = 3072, Mp = 64;
+    std::vector<float> x((size_t)M * K), wref((size_t)N * K);
+    std::vector<uint8_t> wq((size_t)N * K / 32 * 18);
+    uint32_t s = 1;
+    auto fr = [&]() { s = s * 1664525u + 1013904223u; return (float)(s >> 8) / (float)(1u << 23) - 1.0f; };
+    for (auto & v : x) v = fr();
+    for (uint32_t n = 0; n < N; ++n)
+        for (uint32_t kb = 0; kb < K / 32; ++kb) {
+            uint8_t * blk = wq.data() + ((size_t)n * (K / 32) + kb) * 18;
+            ggml_fp16_t d = ggml_fp32_to_fp16(0.01f + 0.02f * (fr() + 1.0f));
+            memcpy(blk, &d, 2);
+            for (int j = 0; j < 16; ++j) {
+                uint8_t lo = (uint8_t)((fr() + 1.0f) * 8.0f) & 15, hi = (uint8_t)((fr() + 1.0f) * 8.0f) & 15;
+                blk[2 + j] = lo | hi << 4;
+                wref[(size_t)n * K + kb * 32 + j] = ((float)lo - 8.0f) * ggml_fp16_to_fp32(d);
+                wref[(size_t)n * K + kb * 32 + j + 16] = ((float)hi - 8.0f) * ggml_fp16_to_fp32(d);
+            }
+        }
+    vk_buffer X = ggml_vk_create_buffer_device(dev, x.size() * 4), W = ggml_vk_create_buffer_device(dev, wq.size()),
+              P = ggml_vk_create_buffer_device(dev, wq.size()), A = ggml_vk_create_buffer_device(dev, (size_t)Mp * K * 2),
+              C = ggml_vk_create_buffer_device(dev, (size_t)M * N * 4);
+    ggml_vk_buffer_write(X, 0, x.data(), x.size() * 4);
+    ggml_vk_buffer_write(W, 0, wq.data(), wq.size());
+    vk::CommandPool pool = dev->device.createCommandPool(
+        vk::CommandPoolCreateInfo(vk::CommandPoolCreateFlagBits::eResetCommandBuffer, dev->compute_queue->queue_family_index));
+    vk::CommandBuffer cb = dev->device.allocateCommandBuffers(vk::CommandBufferAllocateInfo(pool, vk::CommandBufferLevel::ePrimary, 1))[0];
+    cb.begin(vk::CommandBufferBeginInfo(vk::CommandBufferUsageFlagBits::eOneTimeSubmit));
+    auto bar = [&]() {
+        vk::MemoryBarrier mb(vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eTransferWrite,
+                             vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite);
+        cb.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer,
+                           vk::PipelineStageFlagBits::eComputeShader, {}, { mb }, {}, {});
+    };
+    ablas_handle h = (ablas_handle)dev->ablas;
+    VkCommandBuffer c = (VkCommandBuffer)cb;
+    ablas_buf bW = { (VkBuffer)W->buffer, 0, wq.size() }, bP = { (VkBuffer)P->buffer, 0, wq.size() },
+              bX = { (VkBuffer)X->buffer, 0, x.size() * 4 }, bA = { (VkBuffer)A->buffer, 0, (VkDeviceSize)Mp * K * 2 },
+              bC = { (VkBuffer)C->buffer, 0, (VkDeviceSize)M * N * 4 };
+    bar();
+    int st1 = ablas_q4_0_pack_ggml(h, c, N, K, bW, bP);
+    int st2 = ablas_pack_a_f32(h, c, M, K, bX, bA);
+    bar();
+    int st3 = ablas_gemm_f32out(h, c, 1, M, N, K, bA, bP, bC);
+    cb.end();
+    vk::Fence f = dev->device.createFence({});
+    dev->compute_queue->handle->lock();
+    dev->compute_queue->handle->queue.submit({ vk::SubmitInfo(0, nullptr, nullptr, 1, &cb) }, f);
+    dev->compute_queue->handle->unlock();
+    (void)dev->device.waitForFences({ f }, true, UINT64_MAX);
+    std::vector<float> cm((size_t)M * N);
+    ggml_vk_buffer_read(C, 0, cm.data(), cm.size() * 4);
+    double maxe = 0, maxr = 0;
+    for (uint32_t m = 0; m < M; ++m)
+        for (uint32_t n = 0; n < N; n += 7) {
+            double r = 0;
+            for (uint32_t k = 0; k < K; ++k) r += (double)ggml_fp16_to_fp32(ggml_fp32_to_fp16(x[(size_t)m * K + k])) * wref[(size_t)n * K + k];
+            maxe = std::max(maxe, fabs(cm[(size_t)m * N + n] - r));
+            maxr = std::max(maxr, fabs(r));
+        }
+    fprintf(stderr, "ablas selftest (status %d %d %d, kernel %s): max error %.3g of max |C| %.3g -> %s\n", st1, st2, st3,
+            ablas_last_kernel(h), maxe, maxr, maxe / maxr < 2e-2 ? "PASS" : "FAIL");
+    dev->device.destroyFence(f);
+    dev->device.destroyCommandPool(pool);
+}
+
+// One-time weight repack, W (ggml's layout) -> P (AdrenoBLAS's), through scratch when W and P are the same memory, in
+// its own submission that is waited for: the graph's command buffers stay free of the copies (up to 50 MB per weight),
+// and GGML_VK_ABLAS_CHECK_REPACK=1 can compare the result with the CPU's view of the weight (F16 only; slow, memory-hungry).
+static void ggml_vk_ablas_repack(vk_device & dev, bool q4, uint32_t N, uint32_t K, ablas_buf W, ablas_buf P, vk_buffer scratch,
+                                 vk_buffer wbuf = nullptr, vk_buffer pbuf = nullptr, const char * name = "") {
+    static vk::CommandPool pool;
+    static vk::CommandBuffer cb;
+    static vk::Fence fence;
+    if (!pool) {
+        pool = dev->device.createCommandPool(
+            vk::CommandPoolCreateInfo(vk::CommandPoolCreateFlagBits::eResetCommandBuffer, dev->compute_queue->queue_family_index));
+        cb = dev->device.allocateCommandBuffers(vk::CommandBufferAllocateInfo(pool, vk::CommandBufferLevel::ePrimary, 1))[0];
+        fence = dev->device.createFence({});
+    }
+    ablas_handle h = (ablas_handle)dev->ablas;
+    static const bool check = getenv("GGML_VK_ABLAS_CHECK_REPACK") != nullptr;
+    std::vector<ggml_fp16_t> orig;
+    if (check && !q4) {
+        orig.resize((size_t)N * K);
+        ggml_vk_buffer_read(wbuf, W.offset, orig.data(), orig.size() * 2);
+    }
+    auto bar = [&]() {
+        vk::MemoryBarrier mb(vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite,
+                             vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite);
+        cb.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer,
+                           vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer, {}, { mb }, {}, {});
+    };
+    cb.begin(vk::CommandBufferBeginInfo(vk::CommandBufferUsageFlagBits::eOneTimeSubmit));
+    bar();
+    ablas_buf src = W;
+    if (scratch) {
+        cb.copyBuffer((vk::Buffer)W.buffer, scratch->buffer, { vk::BufferCopy(W.offset, 0, W.range) });
+        bar();
+        src = { (VkBuffer)scratch->buffer, 0, W.range };
+    }
+    VkCommandBuffer c = (VkCommandBuffer)cb;
+    ablas_status st = q4 ? ablas_q4_0_pack_ggml(h, c, N, K, src, P) : ablas_pack_b(h, c, ABLAS_OP_T, K, N, src, P);
+    GGML_ASSERT(st == ABLAS_OK);
+    bar();
+    cb.end();
+    dev->compute_queue->handle->lock();
+    dev->compute_queue->handle->queue.submit({ vk::SubmitInfo(0, nullptr, nullptr, 1, &cb) }, fence);
+    dev->compute_queue->handle->unlock();
+    VK_CHECK(dev->device.waitForFences({ fence }, true, UINT64_MAX), "ablas repack", dev);
+    dev->device.resetFences({ fence });
+    cb.reset();
+    if (check && !q4) {  // GGML_VK_ABLAS_CHECK_REPACK: the CPU's view of the weight vs the GPU's copy and repack
+        const size_t n = (size_t)N * K;
+        std::vector<ggml_fp16_t> sv(n), pk(n);
+        size_t bad_s = 0, bad_p = 0;
+        if (scratch) {
+            ggml_vk_buffer_read(scratch, 0, sv.data(), n * 2);
+            for (size_t i = 0; i < n; ++i) bad_s += sv[i] != orig[i];
+        }
+        ggml_vk_buffer_read(pbuf, P.offset, pk.data(), n * 2);
+        for (uint32_t r = 0; r < N; ++r)
+            for (uint32_t k = 0; k < K; ++k)
+                bad_p += pk[((size_t)(r / 64) * (K / 16) + k / 16) * 1024 + (r % 64) * 16 + k % 16] != orig[(size_t)r * K + k];
+        fprintf(stderr, "ablas repack %-24s %ux%u: transfer copy %zu wrong, repack %zu wrong (of %zu)\n", name, N, K, bad_s, bad_p, n);
+    }
+}
+
+static bool ggml_vk_ablas_mul_mat(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (!ggml_vk_ablas_weight(ctx, src0)) {
+        return false;
+    }
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src1) && ggml_is_contiguous(dst) && src1->ne[2] == 1 && src1->ne[3] == 1);
+    vk_device & dev = ctx->device;
+    ablas_handle h = (ablas_handle)dev->ablas;
+    static bool selftested = false;
+    if (!selftested && getenv("GGML_VK_ABLAS_SELFTEST")) {
+        selftested = true;
+        ggml_vk_ablas_selftest(dev);
+    }
+    const uint32_t K = (uint32_t)src0->ne[0], N = (uint32_t)src0->ne[1], M = (uint32_t)src1->ne[1];
+    const bool q4 = src0->type == GGML_TYPE_Q4_0;
+    // (ggml_vk_preallocate_buffers may submit and restart the command buffer: read it again after that call)
+    VkCommandBuffer cmd = (VkCommandBuffer)subctx->s->buffer->buf;
+    const vk_subbuffer w = ggml_vk_tensor_subbuffer(ctx, src0);
+    const vk_subbuffer x = ggml_vk_tensor_subbuffer(ctx, src1);
+    const vk_subbuffer d = ggml_vk_tensor_subbuffer(ctx, dst);
+    const size_t w_sz = ggml_nbytes(src0);
+    ablas_buf W = { (VkBuffer)w.buffer->buffer, w.offset, w_sz };
+    ablas_status st;
+
+    const int mode = ggml_vk_ablas_mode();
+    if (!ggml_vk_ablas_takes(src0, M)) {
+        return false;
+    }
+    if (!ggml_vk_ablas_inplace(src0)) {  // repacked copy; the original weight stays as it is
+        const std::pair<VkBuffer, uint64_t> key((VkBuffer)w.buffer->buffer, w.offset);
+        auto it = dev->ablas_copies.find(key);
+        if (it == dev->ablas_copies.end()) {
+            vk_buffer nb = ggml_vk_create_buffer_device(dev, w_sz);
+            ggml_vk_ablas_repack(dev, q4, N, K, W, { (VkBuffer)nb->buffer, 0, w_sz }, nullptr, w.buffer, nb, src0->name);
+            it = dev->ablas_copies.emplace(key, nb).first;
+        }
+        W = { (VkBuffer)it->second->buffer, 0, w_sz };
+    } else if (!dev->ablas_packed.count({ (VkBuffer)w.buffer->buffer, w.offset })) {  // first use: repack in place, through a staging copy
+        if (dev->ablas_scratch.empty() || dev->ablas_scratch.back()->size < w_sz) {
+            dev->ablas_scratch.push_back(ggml_vk_create_buffer_device(dev, std::max<size_t>(w_sz, 64u << 20)));
+        }
+        ggml_vk_ablas_repack(dev, q4, N, K, W, W, dev->ablas_scratch.back(), w.buffer, w.buffer, src0->name);
+        dev->ablas_packed.insert({ (VkBuffer)w.buffer->buffer, w.offset });
+    }
+
+    const uint32_t Mp = (M + 63) / 64 * 64;
+    const size_t a_sz = (size_t)Mp * K * 2;
+    if (ctx->prealloc_size_y < a_sz) {
+        ctx->prealloc_size_y = a_sz;
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+    // q/k/v and gate/up read the same activations: pack them once (the tiles stay in prealloc_y until ggml uses it)
+    const bool packed = ctx->prealloc_y_last_pipeline_used == ggml_vk_ablas_packed_marker() &&
+                        ctx->prealloc_y_last_tensor_used == src1 && mode != ABLAS_VERIFY;
+    if (ctx->prealloc_y_need_sync && !packed) {
+        ggml_vk_sync_buffers(ctx, subctx);
+    }
+    cmd = (VkCommandBuffer)subctx->s->buffer->buf;
+    ablas_buf X = { (VkBuffer)x.buffer->buffer, x.offset, (VkDeviceSize)M * K * 4 };
+    ablas_buf A = { (VkBuffer)ctx->prealloc_y->buffer, 0, a_sz };
+    ablas_buf C = { (VkBuffer)d.buffer->buffer, d.offset, (VkDeviceSize)M * N * 4 };
+    vk_buffer vb;
+    if (mode == ABLAS_VERIFY) {  // AdrenoBLAS writes its own buffer; ggml computes dst as usual
+        vb = ggml_vk_create_buffer_device(dev, (size_t)M * N * 4);
+        C = { (VkBuffer)vb->buffer, 0, (VkDeviceSize)M * N * 4 };
+    }
+    if (!packed) {
+        st = ablas_pack_a_f32(h, cmd, M, K, X, A);
+        GGML_ASSERT(st == ABLAS_OK);
+        ggml_vk_sync_buffers(ctx, subctx);
+    }
