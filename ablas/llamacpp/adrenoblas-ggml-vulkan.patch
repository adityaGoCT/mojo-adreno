+#ifdef GGML_VULKAN_ADRENOBLAS
+// AdrenoBLAS path for MUL_MAT on a model weight ("blk.*.weight", fp16 or Q4_0, 2D, both dims multiples of 64), through
+// AdrenoBLASLt (lt/ablasLt.h): the first time a weight is used it is repacked into AdrenoBLAS's format, in place (same
+// size) or into a copy (GGML_VK_ABLAS_MODE above); the fp32 activations are packed into fp16 tiles in prealloc_y
+// (once for matmuls sharing them), and the GEMM writes the fp32 result. Matmuls that come here are not fused into
+// ggml's kernels (ggml_vk_can_fuse); the gate/up/SwiGLU group is fused into one AdrenoBLAS GEMM instead
+// (ggml_vk_ablas_swiglu).
+static bool ggml_vk_ablas_weight(const ggml_backend_vk_context * ctx, const ggml_tensor * w) {
+    if (!ctx->device->ablas || !w || (w->type != GGML_TYPE_F16 && w->type != GGML_TYPE_Q4_0)) {
+        return false;
+    }
+    const size_t n = strlen(w->name);
+    if (strncmp(w->name, "blk.", 4) != 0 || n < 7 || strcmp(w->name + n - 7, ".weight") != 0) {
+        return false;
+    }
+    static const char * filter = getenv("GGML_VK_ABLAS_FILTER");  // debugging: only weights whose name contains this
+    if (filter && !strstr(w->name, filter)) {
+        return false;
+    }
+    return w->ne[2] == 1 && w->ne[3] == 1 && w->ne[0] % 64 == 0 && w->ne[1] % 64 == 0 && ggml_is_contiguous(w) &&
+           w->view_src == nullptr && w->buffer && !ggml_backend_buffer_is_host(w->buffer);
+}
+
+static ablasLtHandle ggml_vk_ablas_lt(const vk_device & dev) { return (ablasLtHandle)dev->ablas_lt; }
+static uint32_t ggml_vk_ablas_up64(int64_t m) { return (uint32_t)((m + 63) / 64 * 64); }
+
+// One-time weight repack, W (ggml's layout) -> P (AdrenoBLAS's), through scratch when W and P are the same memory, in
+// its own submission that is waited for, so the graph's command buffers stay free of it.
+static void ggml_vk_ablas_repack(vk_device & dev, bool q4, uint32_t N, uint32_t K, ablas_buf W, ablas_buf P, vk_buffer scratch) {
+    static vk::CommandPool pool;
+    static vk::CommandBuffer cb;
+    static vk::Fence fence;
+    if (!pool) {
+        pool = dev->device.createCommandPool(
+            vk::CommandPoolCreateInfo(vk::CommandPoolCreateFlagBits::eResetCommandBuffer, dev->compute_queue->queue_family_index));
+        cb = dev->device.allocateCommandBuffers(vk::CommandBufferAllocateInfo(pool, vk::CommandBufferLevel::ePrimary, 1))[0];
+        fence = dev->device.createFence({});
+    }
+    auto bar = [&]() {
+        vk::MemoryBarrier mb(vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite,
+                             vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite | vk::AccessFlagBits::eTransferRead | vk::AccessFlagBits::eTransferWrite);
+        cb.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer,
+                           vk::PipelineStageFlagBits::eComputeShader | vk::PipelineStageFlagBits::eTransfer, {}, { mb }, {}, {});
+    };
+    cb.begin(vk::CommandBufferBeginInfo(vk::CommandBufferUsageFlagBits::eOneTimeSubmit));
+    bar();
+    ablas_buf src = W;
+    if (scratch) {
+        cb.copyBuffer((vk::Buffer)W.buffer, scratch->buffer, { vk::BufferCopy(W.offset, 0, W.range) });
+        bar();
+        src = { (VkBuffer)scratch->buffer, 0, W.range };
+    }
+    ablas_status st = ablasLtWeightPackDevice(ggml_vk_ablas_lt(dev), (VkCommandBuffer)cb, q4 ? ABLASLT_Q4_0 : ABLASLT_F16,
+                                              q4 ? ABLASLT_SRC_GGML_Q4_0 : ABLASLT_SRC_F16_ROWS, src, N, K, P);
+    GGML_ASSERT(st == ABLAS_OK);
+    bar();
+    cb.end();
+    dev->compute_queue->handle->lock();
+    dev->compute_queue->handle->queue.submit({ vk::SubmitInfo(0, nullptr, nullptr, 1, &cb) }, fence);
+    dev->compute_queue->handle->unlock();
+    VK_CHECK(dev->device.waitForFences({ fence }, true, UINT64_MAX), "ablas repack", dev);
+    dev->device.resetFences({ fence });
+    cb.reset();
+}
+
+// The weight in AdrenoBLAS's format, repacked on first use: a copy, or its own memory after an in-place repack.
+static ablas_buf ggml_vk_ablas_weight_buf(ggml_backend_vk_context * ctx, const ggml_tensor * w) {
+    vk_device & dev = ctx->device;
+    const bool q4 = w->type == GGML_TYPE_Q4_0;
+    const uint32_t K = (uint32_t)w->ne[0], N = (uint32_t)w->ne[1];
+    const vk_subbuffer s = ggml_vk_tensor_subbuffer(ctx, w);
+    const size_t bytes = ggml_nbytes(w);
+    const ablas_buf W = { (VkBuffer)s.buffer->buffer, s.offset, bytes };
+    const std::pair<VkBuffer, uint64_t> key((VkBuffer)s.buffer->buffer, s.offset);
+    if (!ggml_vk_ablas_inplace(w)) {
+        auto it = dev->ablas_copies.find(key);
+        if (it == dev->ablas_copies.end()) {
+            vk_buffer nb = ggml_vk_create_buffer_device(dev, bytes);
+            ggml_vk_ablas_repack(dev, q4, N, K, W, { (VkBuffer)nb->buffer, 0, bytes }, nullptr);
+            it = dev->ablas_copies.emplace(key, nb).first;
+        }
+        return { (VkBuffer)it->second->buffer, 0, bytes };
+    }
+    if (!dev->ablas_packed.count(key)) {
+        if (dev->ablas_scratch.empty() || dev->ablas_scratch.back()->size < bytes) {
+            dev->ablas_scratch.push_back(ggml_vk_create_buffer_device(dev, std::max<size_t>(bytes, 64u << 20)));
+        }
+        ggml_vk_ablas_repack(dev, q4, N, K, W, W, dev->ablas_scratch.back());
+        dev->ablas_packed.insert(key);
+    }
+    return W;
+}
+
+// x's activation tiles [roundup(M, 64), K]: the fused gate/up GEMM's output when x is the GLU it replaced, else x packed
+// into prealloc_y (once for the matmuls that share x: q/k/v).
+static ablas_buf ggml_vk_ablas_activations(ggml_backend_vk_context * ctx, vk_context & subctx, const ggml_tensor * x,
+                                           bool verify) {
+    const uint32_t K = (uint32_t)x->ne[0], M = (uint32_t)x->ne[1], Mp = ggml_vk_ablas_up64(M);
+    const size_t bytes = (size_t)Mp * K * 2;
+    if (x == ctx->ablas_act_tensor) {
+        ggml_vk_sync_buffers(ctx, subctx);  // written by the fused gate/up GEMM
+        return { (VkBuffer)ctx->ablas_act->buffer, 0, bytes };
+    }
+    if (ctx->prealloc_size_y < bytes) {
+        ctx->prealloc_size_y = bytes;
+        ggml_vk_preallocate_buffers(ctx, subctx);  // may submit and restart the command buffer
+    }
+    const ablas_buf A = { (VkBuffer)ctx->prealloc_y->buffer, 0, bytes };
+    if (ctx->prealloc_y_last_pipeline_used == ggml_vk_ablas_packed_marker() && ctx->prealloc_y_last_tensor_used == x && !verify) {
+        return A;
+    }
+    if (ctx->prealloc_y_need_sync) {
+        ggml_vk_sync_buffers(ctx, subctx);
+    }
+    const vk_subbuffer xs = ggml_vk_tensor_subbuffer(ctx, x);
+    const ablasLtLayout xl = { ABLASLT_F32, ABLASLT_ORDER_ROW, M, K };
+    ablas_status st = ablasLtPack(ggml_vk_ablas_lt(ctx->device), (VkCommandBuffer)subctx->s->buffer->buf,
+                                  { (VkBuffer)xs.buffer->buffer, xs.offset, (VkDeviceSize)M * K * 4 }, &xl, A);
+    GGML_ASSERT(st == ABLAS_OK);
+    ggml_vk_sync_buffers(ctx, subctx);
+    ctx->prealloc_y_last_pipeline_used = ggml_vk_ablas_packed_marker();
+    ctx->prealloc_y_last_tensor_used = x;
+    return A;
+}
+
+static bool ggml_vk_ablas_mul_mat(ggml_backend_vk_context * ctx, vk_context& subctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (!ggml_vk_ablas_weight(ctx, src0)) {
+        return false;
+    }
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src1) && ggml_is_contiguous(dst) && src1->ne[2] == 1 && src1->ne[3] == 1);
+    const uint32_t K = (uint32_t)src0->ne[0], N = (uint32_t)src0->ne[1], M = (uint32_t)src1->ne[1];
+    const int mode = ggml_vk_ablas_mode();
+    if (!ggml_vk_ablas_takes(src0, M) && src1 != ctx->ablas_act_tensor) {
+        return false;
+    }
+    const ablas_buf W = ggml_vk_ablas_weight_buf(ctx, src0);
+    const ablas_buf A = ggml_vk_ablas_activations(ctx, subctx, src1, mode == ABLAS_VERIFY);
+    const vk_subbuffer d = ggml_vk_tensor_subbuffer(ctx, dst);
+    ablas_buf C = { (VkBuffer)d.buffer->buffer, d.offset, (VkDeviceSize)M * N * 4 };
+    vk_buffer vb;
+    if (mode == ABLAS_VERIFY) {  // AdrenoBLAS writes its own buffer; ggml computes dst as usual
+        vb = ggml_vk_create_buffer_device(ctx->device, (size_t)M * N * 4);
+        C = { (VkBuffer)vb->buffer, 0, (VkDeviceSize)M * N * 4 };
+    }
+    const ablasLtLayout al = { ABLASLT_F16, ABLASLT_ORDER_TILED, ggml_vk_ablas_up64(M), K },
+                        wl = { src0->type == GGML_TYPE_Q4_0 ? ABLASLT_Q4_0 : ABLASLT_F16, ABLASLT_ORDER_WEIGHT, N, K },
+                        cl = { ABLASLT_F32, ABLASLT_ORDER_ROW, M, N };
+    const ablasLtMatmulDesc plain = { ABLASLT_EPILOGUE_DEFAULT };
+    ablas_status st = ablasLtMatmul(ggml_vk_ablas_lt(ctx->device), (VkCommandBuffer)subctx->s->buffer->buf, &plain, A, &al,
+                                    W, &wl, C, &cl, {});
+    GGML_ASSERT(st == ABLAS_OK);
+    ctx->prealloc_y_need_sync = true;  // ggml syncs before it next writes prealloc_y
+    if (mode == ABLAS_VERIFY) {  // ggml computes dst from the original weight too; ref is copied right after (verify_copy)
+        g_ablas_checks.push_back({ vb, nullptr, M, N, src0->name });
+        return false;
+    }
+    return true;
+}
+
+// llama.cpp's FFN: up = W_up x; gate = W_gate x; silu(gate) * up (GGML_OP_GLU, SWIGLU), then down. With Q4_0 weights in
+// copy mode the three nodes become one AdrenoBLAS GEMM over the interleaved gate|up weight with the SwiGLU epilogue
+// (ablasLt EPILOGUE_SWIGLU). Its result stays in AdrenoBLAS's tiles (ctx->ablas_act) for the down projection, the
+// GLU's only consumer, which reads them instead of packing; the GLU's own tensor is never written.
+// GGML_VK_ABLAS_SWIGLU=0 turns it off.
+static bool ggml_vk_ablas_swiglu_fusable(ggml_backend_vk_context * ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool off = getenv("GGML_VK_ABLAS_SWIGLU") && !strcmp(getenv("GGML_VK_ABLAS_SWIGLU"), "0");
+    if (!ctx->device->ablas || off || ggml_vk_ablas_mode() == ABLAS_VERIFY || i + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * m0 = cgraph->nodes[i], * m1 = cgraph->nodes[i + 1], * glu = cgraph->nodes[i + 2];
+    if (m0->op != GGML_OP_MUL_MAT || m1->op != GGML_OP_MUL_MAT || glu->op != GGML_OP_GLU ||
+        ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || !glu->src[1] || ggml_get_op_params_i32(glu, 1) != 0) {
+        return false;
+    }
+    const ggml_tensor * g = glu->src[0], * u = glu->src[1];
+    if (!((g == m0 && u == m1) || (g == m1 && u == m0))) {
+        return false;
+    }
+    const ggml_tensor * wg = g->src[0], * wu = u->src[0], * x = g->src[1];
+    if (u->src[1] != x || wg->type != GGML_TYPE_Q4_0 || wu->type != GGML_TYPE_Q4_0 || !ggml_are_same_shape(wg, wu) ||
+        !ggml_vk_ablas_weight(ctx, wg) || !ggml_vk_ablas_weight(ctx, wu) || ggml_vk_ablas_inplace(wg) ||
+        x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[2] != 1 || x->ne[3] != 1 ||
+        x->ne[1] < ggml_vk_ablas_min_m()) {
+        return false;
+    }
+    // the interleaved copy is built on the CPU: both weights must be in host-visible memory
+    if (!ggml_vk_tensor_subbuffer(ctx, wg).buffer->ptr || !ggml_vk_tensor_subbuffer(ctx, wu).buffer->ptr) {
+        return false;
+    }
+    if (!ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU }, { i + 2 }) ||
+        ggml_node_get_use_count(cgraph, i + 2) != 1 || (glu->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    for (int j = i + 3; j < cgraph->n_nodes; ++j) {  // the GLU's consumer: a matmul on AdrenoBLAS, taking it as x
+        const ggml_tensor * n = cgraph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (n->src[s] == glu) {
+                return n->op == GGML_OP_MUL_MAT && s == 1 && ggml_vk_ablas_weight(ctx, n->src[0]) &&
