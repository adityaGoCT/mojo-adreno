#version 450
// AdrenoBLAS pack kernel: dst[C, R] = transpose(src[R, C]), fp16, R and C multiples of 64. Workgroups (C/64, R/64).
// W = 0: dst is plain row-major [C, R]. W = 64 or 32: dst is in panel layout (see panel_copy.comp) with dst row
// = k (C = K) and dst column = x (R = M or N): A panels (W = 64) or B panels (W = 32).
// 64x64 tile: 128-bit loads into shared memory (packed uints), 128-bit stores of 8 halves gathered per tile
// column. 79 GB/s on the Adreno 850 at 2048x2048 (a plain 128-bit copy: 83 GB/s; transpose.comp: 59 GB/s).
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint R = 64u;
layout(constant_id = 1) const uint C = 64u;
layout(constant_id = 2) const uint W = 0u;
layout(std430, binding = 0) readonly buffer S4 { uvec4 s4[]; };
layout(std430, binding = 2) writeonly buffer D4 { uvec4 d4[]; };
shared uint tile[64][33];
uint out_index(uint row, uint x) {  // uvec4 index of dst element (row, x), x a multiple of 8
  if (W == 0u) return (row * R + x) / 8u;
  return (((x / W) * (C / 16u) + row / 16u) * 16u * W + (row % 16u) * W + x % W) / 8u;
}  // 64 rows x 64 halves as 32 packed uints (+1 pad against bank conflicts)
void main() {
  uint t = gl_LocalInvocationIndex;
  uint r0 = gl_WorkGroupID.y * 64u, c0 = gl_WorkGroupID.x * 64u;
  for (uint e = t; e < 512u; e += 256u) {  // tile row e/8, 8-half chunk e%8
    uint r = e >> 3, q = e & 7u;
    uvec4 v = s4[((r0 + r) * C + c0) / 8u + q];
    tile[r][q * 4u] = v.x; tile[r][q * 4u + 1u] = v.y; tile[r][q * 4u + 2u] = v.z; tile[r][q * 4u + 3u] = v.w;
  }
  barrier();
  for (uint e = t; e < 512u; e += 256u) {  // output row (= tile column) e/8, chunk e%8 = tile rows 8q..8q+7
    uint col = e >> 3, q = e & 7u;
    uint w = col >> 1, sh = (col & 1u) * 16u;
    uint h[8];
    for (uint i = 0u; i < 8u; ++i) h[i] = (tile[q * 8u + i][w] >> sh) & 0xffffu;
    d4[out_index(c0 + col, r0 + q * 8u)] = uvec4(h[0] | (h[1] << 16), h[2] | (h[3] << 16), h[4] | (h[5] << 16), h[6] | (h[7] << 16));
  }
}
