#version 450
// The V heads of qkv [M, ncols] (columns vcol0 + g*128 + d) -> V^T tiles per KV head g, the B operand of O = P V:
// element (d, key) at g*128*M + ((d/64)*(M/16) + key/16)*1024 + (d%64)*16 + key%16. Grid (M / 16, nkv), lane = d.
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 128) in;
layout(push_constant) uniform P { uint M; uint ncols; uint vcol0; } pc;
layout(std430, binding = 0) readonly buffer QKV { float16_t qkv[]; };
layout(std430, binding = 1) writeonly buffer VT { f16vec4 vt[]; };
void main() {
  uint kb = gl_WorkGroupID.x, g = gl_WorkGroupID.y, d = gl_LocalInvocationID.x, M = pc.M;
  float16_t v[16];
  for (uint i = 0u; i < 16u; ++i) v[i] = qkv[(kb * 16u + i) * pc.ncols + pc.vcol0 + g * 128u + d];
  uint o = (g * 128u * M + ((d / 64u) * (M / 16u) + kb) * 1024u + (d % 64u) * 16u) / 4u;
  for (uint i = 0u; i < 4u; ++i) vt[o + i] = f16vec4(v[4u * i], v[4u * i + 1u], v[4u * i + 2u], v[4u * i + 3u]);
}
