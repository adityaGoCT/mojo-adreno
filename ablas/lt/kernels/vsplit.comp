#version 450
// The V heads of qkv fp16 [M, ncols] (as tiles, as qksplit.comp; columns vcol0 + g*hdv + d, d < hdv), plus an
// optional bias (fp32 [ncols],
// flags & 2) -> V^T tiles per KV head g, the B operand of O = P V, with this call's keys at key offset koff of a
// cache of krows keys: element (d, key) at g*HD*krows + ((d/64)*(krows/16) + key/16)*1024 + (d%64)*16 + key%16.
// Dims hdv..HD-1 are zero. Grid (M / 16, nkv), lane = d (HD / 128 dims per lane).
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 128) in;
layout(push_constant) uniform P { uint M, ncols, vcol0, hdv, HD, krows, koff, flags; } pc;
layout(std430, binding = 0) readonly buffer QKV { float16_t qkv[]; };
layout(std430, binding = 1) writeonly buffer VT { f16vec4 vt[]; };
layout(std430, binding = 2) readonly buffer BI { float bias[]; };
void main() {
  uint kb = gl_WorkGroupID.x, g = gl_WorkGroupID.y;
  for (uint d = gl_LocalInvocationID.x; d < pc.HD; d += 128u) {
    float v[16];
    uint col = pc.vcol0 + g * pc.hdv + d;
    float b = d < pc.hdv && (pc.flags & 2u) != 0u ? bias[col] : 0.0;
    for (uint i = 0u; i < 16u; ++i) {
      uint r = kb * 16u + i;
      v[i] = d < pc.hdv ? float(qkv[((r / 64u) * (pc.ncols / 16u) + col / 16u) * 1024u + (r % 64u) * 16u + col % 16u]) + b : 0.0;
    }
    uint o = (g * pc.HD * pc.krows + ((d / 64u) * (pc.krows / 16u) + (pc.koff / 16u) + kb) * 1024u + (d % 64u) * 16u) / 4u;
    for (uint i = 0u; i < 4u; ++i) vt[o + i] = f16vec4(v[4u * i], v[4u * i + 1u], v[4u * i + 2u], v[4u * i + 3u]);
  }
}
