#version 450
// LayerNorm into activation tiles (the packed A format of [M, D]):
//   out[r, k] = (x[r, k] - mean[r]) * rstd[r] * w[k] + b[k],  (mean, rstd) = st[r] from lnstats.comp.
// One subgroup per 64 rows x 64 columns (four 2 KB tiles, lane = row). Grid (D / 64, M / 64).
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint D; } pc;
layout(std430, binding = 0) readonly buffer X { vec4 x[]; };
layout(std430, binding = 1) readonly buffer ST { vec2 st[]; };
layout(std430, binding = 2) readonly buffer W { vec4 w[]; };
layout(std430, binding = 3) readonly buffer BI { vec4 bias[]; };
layout(std430, binding = 4) writeonly buffer O { uvec4 o[]; };
uint h2(vec2 v) { return packFloat2x16(f16vec2(v)); }
void main() {
  uint D = pc.D, p = gl_WorkGroupID.y, l = gl_LocalInvocationID.x, r = p * 64u + l;
  vec2 ms = st[r];
  for (uint t = 0u; t < 4u; ++t) {
    uint c = gl_WorkGroupID.x * 4u + t, xi = (r * D + c * 16u) / 4u;
    vec4 a[4];
    for (uint i = 0u; i < 4u; ++i) a[i] = (x[xi + i] - ms.x) * ms.y * w[c * 4u + i] + bias[c * 4u + i];
    uint ob = ((p * (D / 16u) + c) * 1024u + l * 16u) / 8u;
    o[ob] = uvec4(h2(a[0].xy), h2(a[0].zw), h2(a[1].xy), h2(a[1].zw));
    o[ob + 1u] = uvec4(h2(a[2].xy), h2(a[2].zw), h2(a[3].xy), h2(a[3].zw));
  }
}
