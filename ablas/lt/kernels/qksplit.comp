#version 450
// The Q and K heads of qkv fp16 [M, ncols] (as tiles, the GEMM's packed output: element (r, c) at
// ((r/64)*(ncols/16) + c/16)*1024 + (r%64)*16 + c%16; Q heads, then K heads, then V heads, hdv columns each) ->
// Q tiles [nh][qrows, HD] and K tiles [nkv][krows, HD] (this call's rows at krows offset koff: a KV cache), the
// tile format of ablasLtAttention*. Optional bias (fp32 [ncols], flags & 2) and RoPE (flags & 1; HF rotate_half
// over HD: dims d and d + HD/2 pair up; cs fp32 [M][HD] = cos[HD/2] | sin[HD/2] per row). Dims hdv..HD-1 are
// written as zero (SigLIP's heads of 72 padded to 128). hdv and ncols multiples of 8.
// Subgroup = the 16-dim chunk c (c < HD/32) and its partner c + HD/32 of one head, for 64 rows (lane = row).
// Grid (nh + nkv, M / 64, HD / 128), 4 subgroups. Q is written times qscale (ABLASLT_Q_SCALE, a power of two: the
// attention's fp16 Q K^T stays in range).
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint M, ncols, nh, hdv, HD, qrows, krows, koff, flags; float qscale; } pc;
layout(std430, binding = 0) readonly buffer QKV { uvec4 qkv[]; };
layout(std430, binding = 1) readonly buffer CS { vec4 cs[]; };
layout(std430, binding = 2) writeonly buffer Q { uvec4 q[]; };
layout(std430, binding = 3) writeonly buffer K { uvec4 k[]; };
layout(std430, binding = 4) readonly buffer BI { vec4 bias[]; };
vec4 lo(uvec4 u) { return vec4(unpackFloat2x16(u.x), unpackFloat2x16(u.y)); }
vec4 hi(uvec4 u) { return vec4(unpackFloat2x16(u.z), unpackFloat2x16(u.w)); }
uvec2 pk(vec4 v) { return uvec2(packFloat2x16(f16vec2(v.xy)), packFloat2x16(f16vec2(v.zw))); }
uint at(uint r, uint c) { return (((r / 64u) * (pc.ncols / 16u) + c / 16u) * 1024u + (r % 64u) * 16u + c % 16u) / 8u; }
void main() {
  uint p = gl_WorkGroupID.y, l = gl_SubgroupInvocationID, r = p * 64u + l, HD = pc.HD, half_ = HD / 2u;
  uint c = gl_WorkGroupID.z * 4u + gl_SubgroupID;
  bool isq = gl_WorkGroupID.x < pc.nh;
  uint head = isq ? gl_WorkGroupID.x : gl_WorkGroupID.x - pc.nh;
  uint col0 = (isq ? 0u : pc.nh * pc.hdv) + head * pc.hdv;
  uint R = isq ? r : r + pc.koff;
  uint base = head * (isq ? pc.qrows : pc.krows) * HD + ((R / 64u) * (HD / 16u)) * 1024u + (R % 64u) * 16u;
  for (uint s = 0u; s < 2u; ++s) {  // the chunk's two runs of 8 dims, and their partners
    uint d1 = c * 16u + s * 8u, d2 = d1 + half_;
    vec4 x1a = vec4(0.0), x1b = vec4(0.0), x2a = vec4(0.0), x2b = vec4(0.0);
    if (d1 < pc.hdv) {
      uvec4 u = qkv[at(r, col0 + d1)]; x1a = lo(u); x1b = hi(u);
      if ((pc.flags & 2u) != 0u) { x1a += bias[(col0 + d1) / 4u]; x1b += bias[(col0 + d1) / 4u + 1u]; }
    }
    if (d2 < pc.hdv) {
      uvec4 u = qkv[at(r, col0 + d2)]; x2a = lo(u); x2b = hi(u);
      if ((pc.flags & 2u) != 0u) { x2a += bias[(col0 + d2) / 4u]; x2b += bias[(col0 + d2) / 4u + 1u]; }
    }
    vec4 y1a = x1a, y1b = x1b, y2a = x2a, y2b = x2b;
    if ((pc.flags & 1u) != 0u) {
      uint ci = (r * HD + d1) / 4u, si = (r * HD + half_ + d1) / 4u;
      vec4 coa = cs[ci], cob = cs[ci + 1u], sia = cs[si], sib = cs[si + 1u];
      y1a = x1a * coa - x2a * sia; y1b = x1b * cob - x2b * sib;
      y2a = x2a * coa + x1a * sia; y2b = x2b * cob + x1b * sib;
    }
    uint o1 = (base + (d1 / 16u) * 1024u + d1 % 16u) / 8u, o2 = (base + (d2 / 16u) * 1024u + d2 % 16u) / 8u;
    float f = isq ? pc.qscale : 1.0;
    uvec4 w1 = uvec4(pk(y1a * f), pk(y1b * f)), w2 = uvec4(pk(y2a * f), pk(y2b * f));
    if (isq) { q[o1] = w1; q[o2] = w2; } else { k[o1] = w1; k[o2] = w2; }
  }
}
