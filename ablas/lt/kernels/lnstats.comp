#version 450
// LayerNorm statistics: st[r] = (mean, 1 / sqrt(var + eps)) of row r of x fp32 [M, D] (D multiple of 4), two passes
// over the row (no cancellation). One 64-lane subgroup per row. Grid (M / 4).
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint D; float eps; } pc;
layout(std430, binding = 0) readonly buffer X { vec4 x[]; };
layout(std430, binding = 1) writeonly buffer ST { vec2 st[]; };
void main() {
  uint r = gl_WorkGroupID.x * 4u + gl_SubgroupID, l = gl_SubgroupInvocationID, n4 = pc.D / 4u, b = r * n4;
  float s = 0.0;
  for (uint j = l; j < n4; j += 64u) { vec4 v = x[b + j]; s += v.x + v.y + v.z + v.w; }
  float mean = subgroupAdd(s) / float(pc.D), q = 0.0;
  for (uint j = l; j < n4; j += 64u) { vec4 v = x[b + j] - mean; q += dot(v, v); }
  float var = subgroupAdd(q) / float(pc.D);
  if (l == 0u) st[r] = vec2(mean, inversesqrt(var + pc.eps));
}
