#version 450
// qkv fp16 [M, ncols] row-major (ncols = (nh + 2 nkv) * 128: Q heads, K heads, V heads) -> RoPE'd Q as tiles
// [nh][M, 128] and K as tiles [nkv][M, 128] (HF rotate_half: dims d and d + 64 pair up). cs fp32 [M][128] =
// cos[64] | sin[64] per position. Workgroup = one head (x < nh: Q head x, else K head x - nh), subgroup c = the
// 16-dim chunk c of its first 64 dims (it writes tiles c and c + 4), lane = row. Grid (nh + nkv, M / 64).
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint M; uint ncols; uint nh; } pc;
layout(std430, binding = 0) readonly buffer QKV { uvec4 qkv[]; };
layout(std430, binding = 1) readonly buffer CS { vec4 cs[]; };
layout(std430, binding = 2) writeonly buffer Q { uvec4 q[]; };
layout(std430, binding = 3) writeonly buffer K { uvec4 k[]; };
vec4 lo(uvec4 u) { return vec4(unpackFloat2x16(u.x), unpackFloat2x16(u.y)); }
vec4 hi(uvec4 u) { return vec4(unpackFloat2x16(u.z), unpackFloat2x16(u.w)); }
uvec2 pk(vec4 v) { return uvec2(packFloat2x16(f16vec2(v.xy)), packFloat2x16(f16vec2(v.zw))); }
void main() {
  uint p = gl_WorkGroupID.y, c = gl_SubgroupID, l = gl_SubgroupInvocationID, r = p * 64u + l;
  bool isq = gl_WorkGroupID.x < pc.nh;
  uint head = isq ? gl_WorkGroupID.x : gl_WorkGroupID.x - pc.nh;
  uint col = (isq ? 0u : pc.nh * 128u) + head * 128u + c * 16u;
  uint base = head * pc.M * 128u;
  uint t1 = (base + ((p * 8u + c) * 1024u + l * 16u)) / 8u, t2 = (base + ((p * 8u + c + 4u) * 1024u + l * 16u)) / 8u;
  for (uint i = 0u; i < 2u; ++i) {  // 8 dims at a time
    uvec4 u1 = qkv[(r * pc.ncols + col) / 8u + i], u2 = qkv[(r * pc.ncols + col + 64u) / 8u + i];
    uint ci = (r * 128u + c * 16u) / 4u + 2u * i, si = (r * 128u + 64u + c * 16u) / 4u + 2u * i;
    vec4 x1a = lo(u1), x1b = hi(u1), x2a = lo(u2), x2b = hi(u2);
    vec4 coa = cs[ci], cob = cs[ci + 1u], sia = cs[si], sib = cs[si + 1u];
    uvec4 y1 = uvec4(pk(x1a * coa - x2a * sia), pk(x1b * cob - x2b * sib));
    uvec4 y2 = uvec4(pk(x2a * coa + x1a * sia), pk(x2b * cob + x1b * sib));
    if (isq) { q[t1 + i] = y1; q[t2 + i] = y2; } else { k[t1 + i] = y1; k[t2 + i] = y2; }
  }
}
