#version 450
// gu fp16 [M, 16384] row-major (gate | up) -> a = silu(gate) * up as R tiles [M, 8192]: one subgroup per output
// tile (lane = row). Grid (8192 / 64, M / 64), 4 subgroups.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer GU { uvec4 gu[]; };
layout(std430, binding = 2) writeonly buffer A { uvec4 a[]; };
vec2 f2(uint u) { return vec2(unpackFloat2x16(u)); }
uint silu2(uint g, uint u) { vec2 gg = f2(g); return packFloat2x16(f16vec2(gg / (1.0 + exp(-gg)) * f2(u))); }
void main() {
  uint p = gl_WorkGroupID.y, c = gl_WorkGroupID.x * 4u + gl_SubgroupID, l = gl_SubgroupInvocationID, r = p * 64u + l;
  uint gi = (r * 16384u + c * 16u) / 8u, ob = ((p * 512u + c) * 1024u + l * 16u) / 8u;
  for (uint i = 0u; i < 2u; ++i) {
    uvec4 g = gu[gi + i], u = gu[gi + 1024u + i];
    a[ob + i] = uvec4(silu2(g.x, u.x), silu2(g.y, u.y), silu2(g.z, u.z), silu2(g.w, u.w));
  }
}
