#version 450
// Residual + row statistics: x[r] += y[r] (if add), ss[r] = sum(x[r]^2). One 64-lane subgroup per row, coalesced
// (lane l reads vec4s l, l + 64, ...). x fp32 [M, D], y fp16 [M, D] row-major. Feeds normtile.comp.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint add; } pc;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) readonly buffer Y { f16vec4 y[]; };
layout(std430, binding = 2) writeonly buffer SS { float ss[]; };
void main() {
  uint r = gl_WorkGroupID.x * 4u + gl_SubgroupID, l = gl_SubgroupInvocationID;
  float s = 0.0;
  for (uint j = 0u; j < D / 256u; ++j) {
    uint i = r * (D / 4u) + j * 64u + l;
    vec4 v = x[i];
    if (pc.add != 0u) { v += vec4(y[i]); x[i] = v; }
    s += dot(v, v);
  }
  s = subgroupAdd(s);
  if (l == 0u) ss[r] = s;
}
