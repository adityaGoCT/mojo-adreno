#version 450
// x[r] (+= y[r] if add) then out[r] = x[r] / rms(x[r]) * w, written as R tiles [M, D] (fp16). One workgroup per row,
// 192 lanes x 16 elements. x fp32 [M, D] row-major; y fp16 [M, D] row-major (a GEMM output).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 192) in;
layout(push_constant) uniform P { uint add; float eps; } pc;
layout(std430, binding = 0) buffer X { vec4 x[]; };
layout(std430, binding = 1) readonly buffer Y { f16vec4 y[]; };
layout(std430, binding = 2) readonly buffer W { vec4 w[]; };
layout(std430, binding = 3) writeonly buffer O { f16vec4 o[]; };
shared float part[3];
void main() {
  uint r = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
  uint xi = (r * D + t * 16u) / 4u;
  vec4 v[4];
  float ss = 0.0;
  for (uint i = 0u; i < 4u; ++i) {
    v[i] = x[xi + i];
    if (pc.add != 0u) { v[i] += vec4(y[xi + i]); x[xi + i] = v[i]; }
    ss += dot(v[i], v[i]);
  }
  ss = subgroupAdd(ss);
  if (gl_SubgroupInvocationID == 0u) part[gl_SubgroupID] = ss;
  barrier();
  float sc = inversesqrt((part[0] + part[1] + part[2]) / float(D) + pc.eps);
  uint ob = rtile(r, t * 16u, D) / 4u;
  for (uint i = 0u; i < 4u; ++i) o[ob + i] = f16vec4(w[t * 4u + i] * (v[i] * sc));
}
