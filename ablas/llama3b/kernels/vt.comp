#version 450
// V part of qkv [M, 5120] -> V^T tiles per KV head g: the B operand of O = P V with n = head dim, k = key:
// element (d, key) at g*128*M + ((d/64)*(M/16) + key/16)*1024 + (d%64)*16 + key%16. Grid (M/16, 8), lane = d.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 128) in;
layout(push_constant) uniform P { uint M; } pc;
layout(std430, binding = 0) readonly buffer QKV { float16_t qkv[]; };
layout(std430, binding = 2) writeonly buffer VT { f16vec4 vt[]; };
void main() {
  uint kb = gl_WorkGroupID.x, g = gl_WorkGroupID.y, d = gl_LocalInvocationID.x;
  float16_t v[16];
  for (uint i = 0u; i < 16u; ++i) v[i] = qkv[(kb * 16u + i) * 5120u + 4096u + g * 128u + d];
  uint o = (g * 128u * pc.M + rtile(d, kb * 16u, pc.M)) / 4u;
  for (uint i = 0u; i < 4u; ++i) vt[o + i] = f16vec4(v[4u * i], v[4u * i + 1u], v[4u * i + 2u], v[4u * i + 3u]);
}
