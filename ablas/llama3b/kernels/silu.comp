#version 450
// gu fp16 [M, 16384] row-major (gate | up) -> a = silu(gate) * up as R tiles [M, 8192]. Lane = 16-column chunk.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer GU { f16vec4 gu[]; };
layout(std430, binding = 2) writeonly buffer A { f16vec4 a[]; };
void main() {
  uint r = gl_WorkGroupID.y, c = gl_WorkGroupID.x * 128u + gl_LocalInvocationID.x;  // c: 0..511
  uint gi = (r * 16384u + c * 16u) / 4u, ob = rtile(r, c * 16u, 8192u) / 4u;
  for (uint i = 0u; i < 4u; ++i) {
    vec4 g = vec4(gu[gi + i]), u = vec4(gu[gi + 2048u + i]);
    a[ob + i] = f16vec4(g / (1.0 + exp(-g)) * u);
  }
}
