#version 450
// qkv fp16 [M, 5120] row-major -> RoPE'd Q as R tiles [24][M, 128], K as tiles [8][M, 128]. One subgroup per
// (head, 16-dim chunk c of the first 64 dims) and 64 rows (lane = row): it writes tile c and tile c + 4 of the head
// (dims d and d + 64 pair up, HF rotate_half). cs fp32 [M][128] = cos[64] | sin[64]. Grid (32, M / 64), 4 subgroups:
// work items 0..95 Q (head i/4), 96..127 K.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint M; } pc;
layout(std430, binding = 0) readonly buffer QKV { uvec4 qkv[]; };
layout(std430, binding = 1) readonly buffer CS { vec4 cs[]; };
layout(std430, binding = 2) writeonly buffer Q { uvec4 q[]; };
layout(std430, binding = 3) writeonly buffer K { uvec4 k[]; };
vec4 lo(uvec4 u) { return vec4(unpackFloat2x16(u.x), unpackFloat2x16(u.y)); }
vec4 hi(uvec4 u) { return vec4(unpackFloat2x16(u.z), unpackFloat2x16(u.w)); }
uvec2 pk(vec4 v) { return uvec2(packFloat2x16(f16vec2(v.xy)), packFloat2x16(f16vec2(v.zw))); }
void main() {
  uint p = gl_WorkGroupID.y, item = gl_WorkGroupID.x * 4u + gl_SubgroupID, l = gl_SubgroupInvocationID;
  uint r = p * 64u + l, c = item % 4u;
  bool isq = item < 96u;
  uint head = isq ? item / 4u : (item - 96u) / 4u;
  uint col = (isq ? 0u : 3072u) + head * 128u + c * 16u;
  uint base = head * pc.M * 128u;
  uint t1 = (base + ((p * 8u + c) * 1024u + l * 16u)) / 8u, t2 = (base + ((p * 8u + c + 4u) * 1024u + l * 16u)) / 8u;
  for (uint i = 0u; i < 2u; ++i) {  // 8 dims at a time
    uvec4 u1 = qkv[(r * 5120u + col) / 8u + i], u2 = qkv[(r * 5120u + col + 64u) / 8u + i];
    uint ci = (r * 128u + c * 16u) / 4u + 2u * i, si = (r * 128u + 64u + c * 16u) / 4u + 2u * i;
    vec4 x1a = lo(u1), x1b = hi(u1), x2a = lo(u2), x2b = hi(u2);
    vec4 coa = cs[ci], cob = cs[ci + 1u], sia = cs[si], sib = cs[si + 1u];
    uvec4 y1 = uvec4(pk(x1a * coa - x2a * sia), pk(x1b * cob - x2b * sib));
    uvec4 y2 = uvec4(pk(x2a * coa + x1a * sia), pk(x2b * cob + x1b * sib));
    if (isq) { q[t1 + i] = y1; q[t2 + i] = y2; } else { k[t1 + i] = y1; k[t2 + i] = y2; }
  }
}
