#version 450
// RMSNorm output as R tiles: out[r, k] = w[k] * (x[r, k] * rsqrt(ss[r] / D + eps)) in fp16. One subgroup per
// 64 x 16 tile (lane = row), so each subgroup writes one contiguous 2 KB tile. Grid (D / 64, M / 64), 4 subgroups.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P { float eps; } pc;
layout(std430, binding = 0) readonly buffer X { vec4 x[]; };
layout(std430, binding = 1) readonly buffer SS { float ss[]; };
layout(std430, binding = 2) readonly buffer W { vec4 w[]; };
layout(std430, binding = 3) writeonly buffer O { uvec4 o[]; };
uint h2(vec2 v) { return packFloat2x16(f16vec2(v)); }
void main() {
  uint p = gl_WorkGroupID.y, c = gl_WorkGroupID.x * 4u + gl_SubgroupID, l = gl_SubgroupInvocationID, r = p * 64u + l;
  float sc = inversesqrt(ss[r] / float(D) + pc.eps);
  uint xi = (r * D + c * 16u) / 4u;
  vec4 a0 = w[c * 4u] * (x[xi] * sc), a1 = w[c * 4u + 1u] * (x[xi + 1u] * sc);
  vec4 a2 = w[c * 4u + 2u] * (x[xi + 2u] * sc), a3 = w[c * 4u + 3u] * (x[xi + 3u] * sc);
  uint ob = ((p * (D / 16u) + c) * 1024u + l * 16u) / 8u;
  o[ob] = uvec4(h2(a0.xy), h2(a0.zw), h2(a1.xy), h2(a1.zw));
  o[ob + 1u] = uvec4(h2(a2.xy), h2(a2.zw), h2(a3.xy), h2(a3.zw));
}
