#version 450
// Causal softmax, in place, of one row of S_h = Q_h K_g^T (fp16 R tiles [24][M, M], unscaled), scale 1/sqrt(128):
// the result P is the A operand of O = P V (K = key). Touches keys 0 .. end of the row's 64-key diagonal block
// (zeros after the row's own key); the QK GEMM wrote no further and the PV GEMM reads no further.
// One 64-lane workgroup per (row, head).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint M; float scale; } pc;
layout(std430, binding = 0) buffer S { f16vec4 s[]; };
void main() {
  uint r = gl_WorkGroupID.x, h = gl_WorkGroupID.y, t = gl_LocalInvocationID.x, M = pc.M;
  uint nch = (r / 64u + 1u) * 4u;  // 16-key chunks up to the end of the diagonal 64-key block
  float mx = -1e30;
  for (uint c = t; c < nch; c += 64u)
    for (uint i = 0u; i < 4u; ++i) {
      vec4 v = vec4(s[(h * M * M + rtile(r, c * 16u, M)) / 4u + i]);
      for (uint j = 0u; j < 4u; ++j) if (c * 16u + i * 4u + j <= r) mx = max(mx, v[j]);
    }
  mx = subgroupMax(mx) * pc.scale;
  float sum = 0.0;
  for (uint c = t; c < nch; c += 64u)
    for (uint i = 0u; i < 4u; ++i) {
      vec4 v = vec4(s[(h * M * M + rtile(r, c * 16u, M)) / 4u + i]);
      for (uint j = 0u; j < 4u; ++j) if (c * 16u + i * 4u + j <= r) sum += exp(v[j] * pc.scale - mx);
    }
  float inv = 1.0 / subgroupAdd(sum);
  for (uint c = t; c < nch; c += 64u) {
    uint ob = (h * M * M + rtile(r, c * 16u, M)) / 4u;
    for (uint i = 0u; i < 4u; ++i) {
      vec4 v = vec4(s[ob + i]), p;
      for (uint j = 0u; j < 4u; ++j) p[j] = c * 16u + i * 4u + j <= r ? exp(v[j] * pc.scale - mx) * inv : 0.0;
      s[ob + i] = f16vec4(p);
    }
  }
}
