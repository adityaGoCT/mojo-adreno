#version 450
// AdrenoBLAS pack kernel: K-major source S[KR, X] (row-major) -> panel layout:
//   element (k, x) at ((x / W) * (KR / 16) + k / 16) * 16 * W + (k % 16) * W + x % W
// i.e. 16 x W tiles, row-major inside, K-tiles adjacent within each W-wide panel. W = 64 makes A panels
// (from A stored [K, M]; the GEMM reads them as column-major 64 x 16 tiles); B panels are W = 64 too (from B [K, N]).
// One thread per 8 halves (128 bits); workgroups ceil(KR * X / 8 / 256).
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint KR = 16u;
layout(constant_id = 1) const uint X = 64u;
layout(constant_id = 2) const uint W = 64u;
layout(std430, binding = 0) readonly buffer S4 { uvec4 s4[]; };
layout(std430, binding = 2) writeonly buffer D4 { uvec4 d4[]; };
void main() {
  uint e = gl_GlobalInvocationID.x;
  if (e >= KR * X / 8u) return;
  uint row = e / (X / 8u), x = (e % (X / 8u)) * 8u;
  d4[(((x / W) * (KR / 16u) + row / 16u) * 16u * W + (row % 16u) * W + x % W) / 8u] = s4[e];
}
