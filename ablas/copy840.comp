#version 450
// Adreno 840 backend: ablas_pack_a/_b for operands that are already in the 840's TN layout (A [K,M], B [K,N]):
// a 16-byte-per-lane copy. Spec constant 0 = number of 16-byte elements (rewritten to a constant by ablas.c).
// Bindings as for the transposes: src = binding 0, dst = binding 2. Grid-stride loop (any size, <= 65535 groups).
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint N16 = 1u;
layout(std430, binding = 0) readonly buffer S { uvec4 s[]; };
layout(std430, binding = 2) writeonly buffer D { uvec4 d[]; };
void main() {
  uint n = N16;
  for (uint i = gl_GlobalInvocationID.x; i < n; i += gl_NumWorkGroups.x * 64u) d[i] = s[i];
}
