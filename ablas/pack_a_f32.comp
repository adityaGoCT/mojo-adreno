#version 450
// AdrenoBLAS pack: fp32 activations A[M, K] (row-major) -> fp16 K-minor tiles of an [roundup(M, 64), K] matrix
// (ablas_pack_a's format), rows >= M written as zeros. One subgroup per 64 x 16 tile, lane = row, so each subgroup
// writes one contiguous 2 KB tile. Workgroups (K / 64, roundup(M, 64) / 64), 4 subgroups. K multiple of 64.
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint M = 64u;
layout(constant_id = 1) const uint UNUSED = 0u;
layout(constant_id = 2) const uint K = 64u;
layout(std430, binding = 0) readonly buffer S { vec4 s[]; };
layout(std430, binding = 2) writeonly buffer D { uvec4 d[]; };
uint h2(vec2 v) { return packFloat2x16(f16vec2(v)); }
void main() {
  uint p = gl_WorkGroupID.y, c = gl_WorkGroupID.x * 4u + gl_SubgroupID, l = gl_SubgroupInvocationID, r = p * 64u + l;
  vec4 v0 = vec4(0.0), v1 = vec4(0.0), v2 = vec4(0.0), v3 = vec4(0.0);
  if (r < M) {
    uint si = (r * K + c * 16u) / 4u;
    v0 = s[si], v1 = s[si + 1u], v2 = s[si + 2u], v3 = s[si + 3u];
  }
  uint o = ((p * (K / 16u) + c) * 1024u + l * 16u) / 8u;
  d[o] = uvec4(h2(v0.xy), h2(v0.zw), h2(v1.xy), h2(v1.zw));
  d[o + 1u] = uvec4(h2(v2.xy), h2(v2.zw), h2(v3.xy), h2(v3.zw));
}
