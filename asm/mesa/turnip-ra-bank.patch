+static unsigned
+bank_age(struct ra_file *file, physreg_t start, unsigned size)
+{
+   unsigned last = 0;
+   for (unsigned i = 0; i < size; i++)
+      last = MAX2(last, file->freed_ip[start + i]);
+   return *file->ip - last;
+}
+
+static bool
+bank_src(const struct ir3_register *src)
+{
+   return ra_reg_is_src(src) &&
+          !(src->flags & (IR3_REG_SHARED | IR3_REG_RELATIV | IR3_REG_ARRAY |
+                          IR3_REG_PREDICATE));
+}
+
+static void
+ra_collect_bank_uses(struct ra_ctx *ctx, struct ir3 *ir)
+{
+   ctx->bank_uses = _mesa_pointer_hash_table_create(ctx);
+
+   foreach_block (block, &ir->block_list) {
+      foreach_instr (instr, &block->instr_list) {
+         if (!is_mad(instr->opc) || instr->srcs_count < 3)
+            continue;
+
+         if (!bank_src(instr->srcs[0]) || !bank_src(instr->srcs[1]) ||
+             !bank_src(instr->srcs[2]))
+            continue;
+
+         for (unsigned i = 0; i < 3; i++) {
+            struct ir3_register *def = instr->srcs[i]->def;
+            struct hash_entry *entry =
+               _mesa_hash_table_search(ctx->bank_uses, def);
+            struct util_dynarray *uses;
+            if (entry) {
+               uses = entry->data;
+            } else {
+               uses = ralloc(ctx, struct util_dynarray);
+               util_dynarray_init(uses, ctx);
+               _mesa_hash_table_insert(ctx->bank_uses, def, uses);
+            }
+            util_dynarray_append(uses, instr);
+         }
+      }
+   }
+}
+
+static unsigned
+bank_members(struct ir3_register *reg)
+{
+   return reg->merge_set ? reg->merge_set->regs_count : 1;
+}
+
+static struct ir3_register *
+bank_member(struct ir3_register *reg, unsigned i)
+{
+   return reg->merge_set ? reg->merge_set->regs[i] : reg;
+}
+
+static bool
+bank_has_uses(struct ra_ctx *ctx, struct ir3_register *reg)
+{
+   for (unsigned i = 0; i < bank_members(reg); i++) {
+      if (_mesa_hash_table_search(ctx->bank_uses, bank_member(reg, i)))
+         return true;
+   }
+   return false;
+}
+
+static struct ir3_instruction *
+bank_producer(struct ir3_register *def)
+{
+   struct ir3_instruction *instr = def->instr;
+   if (instr->opc == OPC_META_SPLIT && instr->srcs[0]->def)
+      instr = instr->srcs[0]->def->instr;
+   return instr;
+}
+
+static bool
+bank_ldl_paired(struct ra_ctx *ctx, struct ir3_register *reg)
+{
+   for (unsigned m = 0; m < bank_members(reg); m++) {
+      struct hash_entry *entry =
+         _mesa_hash_table_search(ctx->bank_uses, bank_member(reg, m));
+      if (!entry)
+         continue;
+
+      struct util_dynarray *uses = entry->data;
+      util_dynarray_foreach (uses, struct ir3_instruction *, mad) {
+         for (unsigned i = 0; i < 3; i++) {
+            struct ir3_instruction *producer =
+               bank_producer((*mad)->srcs[i]->def);
+            if (is_tex_or_prefetch(producer) ||
+                (is_load(producer) && !is_local_mem_load(producer)))
+               return true;
+         }
+      }
+   }
+   return false;
+}
+
+static int
+bank_num(struct ra_ctx *ctx, struct ir3_register *src,
+         struct ir3_register *reg, physreg_t dst_physreg)
+{
+   struct ir3_register *def = src->def;
+   physreg_t physreg;
+
+   if (def == reg) {
+      physreg = dst_physreg;
+   } else if (reg->merge_set && def->merge_set == reg->merge_set) {
+      if (dst_physreg < reg->merge_set_offset)
+         return -1;
+      physreg = dst_physreg - reg->merge_set_offset + def->merge_set_offset;
+   } else {
+      if (def->name == 0 || def->name >= ctx->live->definitions_count)
+         return -1;
+      struct ra_interval *interval = ra_interval_get(ctx, def);
+      if (!interval->interval.inserted)
+         return -1;
+      physreg = ra_interval_get_physreg(interval);
+   }
+
+   return ra_physreg_to_num(physreg, def->flags);
+}
+
+static unsigned
+bank_cost(struct ra_ctx *ctx, struct ir3_register *reg, physreg_t dst_physreg)
+{
+   unsigned cost = 0;
+
+   for (unsigned m = 0; m < bank_members(reg); m++) {
+      struct hash_entry *entry =
+         _mesa_hash_table_search(ctx->bank_uses, bank_member(reg, m));
+      if (!entry)
+         continue;
+
+      struct util_dynarray *uses = entry->data;
+      util_dynarray_foreach (uses, struct ir3_instruction *, mad) {
+         int comp[3];
+         unsigned n = 0;
+         for (unsigned i = 0; i < 3; i++) {
+            int num = bank_num(ctx, (*mad)->srcs[i], reg, dst_physreg);
+            if (num >= 0)
+               comp[n++] = num % 2;
+         }
+
+         if (n == 3 && comp[0] == comp[1] && comp[1] == comp[2])
+            cost += 4;
+         else if (n == 2 && comp[0] == comp[1] &&
+                  (debug_get_option_ir3_bankra_mode() & 1))
+            cost += 1;
+      }
+   }
+
+   return cost;
+}
