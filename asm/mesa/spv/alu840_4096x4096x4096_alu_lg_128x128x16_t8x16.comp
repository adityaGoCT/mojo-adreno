#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { f16vec4 at4[]; };   // [K,M]
layout(std430, binding = 1) readonly buffer B { f16vec4 b4[]; };    // [K,N]
layout(std430, binding = 2) writeonly buffer C { f16vec4 c4[]; };   // [M,N]
shared f16vec4 As[16][32];
void main() {
  uint tid = gl_LocalInvocationID.x;
  uint tx = tid % 8u, ty = tid / 8u;
  uint bm = gl_WorkGroupID.y * 128u, bn = gl_WorkGroupID.x * 128u;
  uint M4 = 4096u, N4 = 4096u;
  M4 >>= 2; N4 >>= 2;
  f16vec4 acc[8][4];
  for (int i = 0; i < 8; ++i) for (int j = 0; j < 4; ++j) acc[i][j] = f16vec4(0);
  for (uint k0 = 0; k0 < 4096u; k0 += 16u) {
    { uint i = tid + 0u; uint kk = i / 32u, mm = i % 32u;
      As[kk][mm] = at4[(k0 + kk) * M4 + bm / 4u + mm]; }
    { uint i = tid + 128u; uint kk = i / 32u, mm = i % 32u;
      As[kk][mm] = at4[(k0 + kk) * M4 + bm / 4u + mm]; }
    { uint i = tid + 256u; uint kk = i / 32u, mm = i % 32u;
      As[kk][mm] = at4[(k0 + kk) * M4 + bm / 4u + mm]; }
    { uint i = tid + 384u; uint kk = i / 32u, mm = i % 32u;
      As[kk][mm] = at4[(k0 + kk) * M4 + bm / 4u + mm]; }
    barrier();
    [[unroll]] for (uint k = 0; k < 16u; ++k) {
      f16vec4 a0 = As[k][ty], a1 = As[k][ty + 16u];
      uint br = (k0 + k) * N4 + bn / 4u + tx;
      f16vec4 b0 = b4[br], b1 = b4[br + 8u], b2 = b4[br + 16u], b3 = b4[br + 24u];
      acc[0][0] = a0.x * b0 + acc[0][0]; acc[0][1] = a0.x * b1 + acc[0][1]; acc[0][2] = a0.x * b2 + acc[0][2]; acc[0][3] = a0.x * b3 + acc[0][3];
      acc[1][0] = a0.y * b0 + acc[1][0]; acc[1][1] = a0.y * b1 + acc[1][1]; acc[1][2] = a0.y * b2 + acc[1][2]; acc[1][3] = a0.y * b3 + acc[1][3];
      acc[2][0] = a0.z * b0 + acc[2][0]; acc[2][1] = a0.z * b1 + acc[2][1]; acc[2][2] = a0.z * b2 + acc[2][2]; acc[2][3] = a0.z * b3 + acc[2][3];
      acc[3][0] = a0.w * b0 + acc[3][0]; acc[3][1] = a0.w * b1 + acc[3][1]; acc[3][2] = a0.w * b2 + acc[3][2]; acc[3][3] = a0.w * b3 + acc[3][3];
      acc[4][0] = a1.x * b0 + acc[4][0]; acc[4][1] = a1.x * b1 + acc[4][1]; acc[4][2] = a1.x * b2 + acc[4][2]; acc[4][3] = a1.x * b3 + acc[4][3];
      acc[5][0] = a1.y * b0 + acc[5][0]; acc[5][1] = a1.y * b1 + acc[5][1]; acc[5][2] = a1.y * b2 + acc[5][2]; acc[5][3] = a1.y * b3 + acc[5][3];
      acc[6][0] = a1.z * b0 + acc[6][0]; acc[6][1] = a1.z * b1 + acc[6][1]; acc[6][2] = a1.z * b2 + acc[6][2]; acc[6][3] = a1.z * b3 + acc[6][3];
      acc[7][0] = a1.w * b0 + acc[7][0]; acc[7][1] = a1.w * b1 + acc[7][1]; acc[7][2] = a1.w * b2 + acc[7][2]; acc[7][3] = a1.w * b3 + acc[7][3];
    }
    barrier();
  }
  c4[(bm + 0u + ty * 4u + 0u) * N4 + bn / 4u + 0u + tx] = acc[0][0];
  c4[(bm + 0u + ty * 4u + 0u) * N4 + bn / 4u + 8u + tx] = acc[0][1];
  c4[(bm + 0u + ty * 4u + 0u) * N4 + bn / 4u + 16u + tx] = acc[0][2];
  c4[(bm + 0u + ty * 4u + 0u) * N4 + bn / 4u + 24u + tx] = acc[0][3];
  c4[(bm + 0u + ty * 4u + 1u) * N4 + bn / 4u + 0u + tx] = acc[1][0];
  c4[(bm + 0u + ty * 4u + 1u) * N4 + bn / 4u + 8u + tx] = acc[1][1];
  c4[(bm + 0u + ty * 4u + 1u) * N4 + bn / 4u + 16u + tx] = acc[1][2];
  c4[(bm + 0u + ty * 4u + 1u) * N4 + bn / 4u + 24u + tx] = acc[1][3];
  c4[(bm + 0u + ty * 4u + 2u) * N4 + bn / 4u + 0u + tx] = acc[2][0];
  c4[(bm + 0u + ty * 4u + 2u) * N4 + bn / 4u + 8u + tx] = acc[2][1];
  c4[(bm + 0u + ty * 4u + 2u) * N4 + bn / 4u + 16u + tx] = acc[2][2];
  c4[(bm + 0u + ty * 4u + 2u) * N4 + bn / 4u + 24u + tx] = acc[2][3];
  c4[(bm + 0u + ty * 4u + 3u) * N4 + bn / 4u + 0u + tx] = acc[3][0];
  c4[(bm + 0u + ty * 4u + 3u) * N4 + bn / 4u + 8u + tx] = acc[3][1];
  c4[(bm + 0u + ty * 4u + 3u) * N4 + bn / 4u + 16u + tx] = acc[3][2];
  c4[(bm + 0u + ty * 4u + 3u) * N4 + bn / 4u + 24u + tx] = acc[3][3];
  c4[(bm + 64u + ty * 4u + 0u) * N4 + bn / 4u + 0u + tx] = acc[4][0];
  c4[(bm + 64u + ty * 4u + 0u) * N4 + bn / 4u + 8u + tx] = acc[4][1];
  c4[(bm + 64u + ty * 4u + 0u) * N4 + bn / 4u + 16u + tx] = acc[4][2];
  c4[(bm + 64u + ty * 4u + 0u) * N4 + bn / 4u + 24u + tx] = acc[4][3];
  c4[(bm + 64u + ty * 4u + 1u) * N4 + bn / 4u + 0u + tx] = acc[5][0];
  c4[(bm + 64u + ty * 4u + 1u) * N4 + bn / 4u + 8u + tx] = acc[5][1];
  c4[(bm + 64u + ty * 4u + 1u) * N4 + bn / 4u + 16u + tx] = acc[5][2];
  c4[(bm + 64u + ty * 4u + 1u) * N4 + bn / 4u + 24u + tx] = acc[5][3];
  c4[(bm + 64u + ty * 4u + 2u) * N4 + bn / 4u + 0u + tx] = acc[6][0];
  c4[(bm + 64u + ty * 4u + 2u) * N4 + bn / 4u + 8u + tx] = acc[6][1];
  c4[(bm + 64u + ty * 4u + 2u) * N4 + bn / 4u + 16u + tx] = acc[6][2];
  c4[(bm + 64u + ty * 4u + 2u) * N4 + bn / 4u + 24u + tx] = acc[6][3];
  c4[(bm + 64u + ty * 4u + 3u) * N4 + bn / 4u + 0u + tx] = acc[7][0];
  c4[(bm + 64u + ty * 4u + 3u) * N4 + bn / 4u + 8u + tx] = acc[7][1];
  c4[(bm + 64u + ty * 4u + 3u) * N4 + bn / 4u + 16u + tx] = acc[7][2];
  c4[(bm + 64u + ty * 4u + 3u) * N4 + bn / 4u + 24u + tx] = acc[7][3];
}
