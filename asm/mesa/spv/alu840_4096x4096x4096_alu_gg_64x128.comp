#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { f16vec4 at4[]; };   // [K,M]
layout(std430, binding = 1) readonly buffer B { f16vec4 b4[]; };    // [K,N]
layout(std430, binding = 2) writeonly buffer C { f16vec4 c4[]; };   // [M,N]
void main() {
  uint tid = gl_LocalInvocationID.x;
  uint tx = tid % 16u, ty = tid / 16u;
  uint bm = gl_WorkGroupID.y * 64u, bn = gl_WorkGroupID.x * 128u;
  uint M4 = 4096u, N4 = 4096u;
  M4 >>= 2; N4 >>= 2;
  f16vec4 acc[8][2];
  for (int i = 0; i < 8; ++i) { acc[i][0] = f16vec4(0); acc[i][1] = f16vec4(0); }
  for (uint k0 = 0; k0 < 4096u; k0 += 4u) {
    [[unroll]] for (uint k = 0; k < 4u; ++k) {
      uint ar = (k0 + k) * M4 + bm / 4u + ty;
      f16vec4 a0 = at4[ar], a1 = at4[ar + 8u];
      uint br = (k0 + k) * N4 + bn / 4u + tx;
      f16vec4 b0 = b4[br], b1 = b4[br + 16u];
      acc[0][0] = a0.x * b0 + acc[0][0]; acc[0][1] = a0.x * b1 + acc[0][1];
      acc[1][0] = a0.y * b0 + acc[1][0]; acc[1][1] = a0.y * b1 + acc[1][1];
      acc[2][0] = a0.z * b0 + acc[2][0]; acc[2][1] = a0.z * b1 + acc[2][1];
      acc[3][0] = a0.w * b0 + acc[3][0]; acc[3][1] = a0.w * b1 + acc[3][1];
      acc[4][0] = a1.x * b0 + acc[4][0]; acc[4][1] = a1.x * b1 + acc[4][1];
      acc[5][0] = a1.y * b0 + acc[5][0]; acc[5][1] = a1.y * b1 + acc[5][1];
      acc[6][0] = a1.z * b0 + acc[6][0]; acc[6][1] = a1.z * b1 + acc[6][1];
      acc[7][0] = a1.w * b0 + acc[7][0]; acc[7][1] = a1.w * b1 + acc[7][1];
    }
  }
  c4[(bm + 0u + ty * 4u + 0u) * N4 + bn / 4u + 0u + tx] = acc[0][0];
  c4[(bm + 0u + ty * 4u + 0u) * N4 + bn / 4u + 16u + tx] = acc[0][1];
  c4[(bm + 0u + ty * 4u + 1u) * N4 + bn / 4u + 0u + tx] = acc[1][0];
  c4[(bm + 0u + ty * 4u + 1u) * N4 + bn / 4u + 16u + tx] = acc[1][1];
  c4[(bm + 0u + ty * 4u + 2u) * N4 + bn / 4u + 0u + tx] = acc[2][0];
  c4[(bm + 0u + ty * 4u + 2u) * N4 + bn / 4u + 16u + tx] = acc[2][1];
  c4[(bm + 0u + ty * 4u + 3u) * N4 + bn / 4u + 0u + tx] = acc[3][0];
  c4[(bm + 0u + ty * 4u + 3u) * N4 + bn / 4u + 16u + tx] = acc[3][1];
  c4[(bm + 32u + ty * 4u + 0u) * N4 + bn / 4u + 0u + tx] = acc[4][0];
  c4[(bm + 32u + ty * 4u + 0u) * N4 + bn / 4u + 16u + tx] = acc[4][1];
  c4[(bm + 32u + ty * 4u + 1u) * N4 + bn / 4u + 0u + tx] = acc[5][0];
  c4[(bm + 32u + ty * 4u + 1u) * N4 + bn / 4u + 16u + tx] = acc[5][1];
  c4[(bm + 32u + ty * 4u + 2u) * N4 + bn / 4u + 0u + tx] = acc[6][0];
  c4[(bm + 32u + ty * 4u + 2u) * N4 + bn / 4u + 16u + tx] = acc[6][1];
  c4[(bm + 32u + ty * 4u + 3u) * N4 + bn / 4u + 0u + tx] = acc[7][0];
  c4[(bm + 32u + ty * 4u + 3u) * N4 + bn / 4u + 16u + tx] = acc[7][1];
}
