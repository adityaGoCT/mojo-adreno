#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 2) writeonly buffer C { float c[]; };
void main() {
  vec2 m = vec2(float(a[0])); vec2 d = vec2(float(a[1]));
  float seed = float(gl_LocalInvocationID.x) * float(0.0009765625);
  vec2 x0 = vec2(seed + float(0));
  vec2 x1 = vec2(seed + float(1));
  vec2 x2 = vec2(seed + float(2));
  vec2 x3 = vec2(seed + float(3));
  vec2 x4 = vec2(seed + float(4));
  vec2 x5 = vec2(seed + float(5));
  vec2 x6 = vec2(seed + float(6));
  vec2 x7 = vec2(seed + float(7));
  vec2 x8 = vec2(seed + float(8));
  vec2 x9 = vec2(seed + float(9));
  vec2 x10 = vec2(seed + float(10));
  vec2 x11 = vec2(seed + float(11));
  vec2 x12 = vec2(seed + float(12));
  vec2 x13 = vec2(seed + float(13));
  vec2 x14 = vec2(seed + float(14));
  vec2 x15 = vec2(seed + float(15));
  for (int i = 0; i < 512; ++i) {
    x0 = x0 * m + d;
    x1 = x1 * m + d;
    x2 = x2 * m + d;
    x3 = x3 * m + d;
    x4 = x4 * m + d;
    x5 = x5 * m + d;
    x6 = x6 * m + d;
    x7 = x7 * m + d;
    x8 = x8 * m + d;
    x9 = x9 * m + d;
    x10 = x10 * m + d;
    x11 = x11 * m + d;
    x12 = x12 * m + d;
    x13 = x13 * m + d;
    x14 = x14 * m + d;
    x15 = x15 * m + d;
  }
  vec2 sum = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 + x12 + x13 + x14 + x15;
  float r = float(sum.x + sum.y);
  if (r == 1234.0) c[gl_GlobalInvocationID.x] = r;
}
