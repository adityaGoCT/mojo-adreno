  float16_t m = float16_t(float16_t(a[0])); float16_t d = float16_t(float16_t(a[1]));
  float16_t seed = float16_t(gl_LocalInvocationID.x) * float16_t(0.0009765625);
  float16_t x0 = float16_t(seed + float16_t(0));
