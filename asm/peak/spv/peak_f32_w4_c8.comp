#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 2) writeonly buffer C { float c[]; };
void main() {
  vec4 m = vec4(float(a[0])); vec4 d = vec4(float(a[1]));
  float seed = float(gl_LocalInvocationID.x) * float(0.0009765625);
  vec4 x0 = vec4(seed + float(0));
  vec4 x1 = vec4(seed + float(1));
  vec4 x2 = vec4(seed + float(2));
  vec4 x3 = vec4(seed + float(3));
  vec4 x4 = vec4(seed + float(4));
  vec4 x5 = vec4(seed + float(5));
  vec4 x6 = vec4(seed + float(6));
  vec4 x7 = vec4(seed + float(7));
  for (int i = 0; i < 512; ++i) {
    x0 = x0 * m + d;
    x1 = x1 * m + d;
    x2 = x2 * m + d;
    x3 = x3 * m + d;
    x4 = x4 * m + d;
    x5 = x5 * m + d;
    x6 = x6 * m + d;
    x7 = x7 * m + d;
  }
  vec4 sum = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7;
  float r = float(sum.x + sum.y + sum.z + sum.w);
  if (r == 1234.0) c[gl_GlobalInvocationID.x] = r;
}
