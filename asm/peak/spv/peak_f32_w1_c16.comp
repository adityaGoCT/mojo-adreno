#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 2) writeonly buffer C { float c[]; };
void main() {
  float m = float(float(a[0])); float d = float(float(a[1]));
  float seed = float(gl_LocalInvocationID.x) * float(0.0009765625);
  float x0 = float(seed + float(0));
  float x1 = float(seed + float(1));
  float x2 = float(seed + float(2));
  float x3 = float(seed + float(3));
  float x4 = float(seed + float(4));
  float x5 = float(seed + float(5));
  float x6 = float(seed + float(6));
  float x7 = float(seed + float(7));
  float x8 = float(seed + float(8));
  float x9 = float(seed + float(9));
  float x10 = float(seed + float(10));
  float x11 = float(seed + float(11));
  float x12 = float(seed + float(12));
  float x13 = float(seed + float(13));
  float x14 = float(seed + float(14));
  float x15 = float(seed + float(15));
  for (int i = 0; i < 512; ++i) {
    x0 = x0 * m + d;
    x1 = x1 * m + d;
    x2 = x2 * m + d;
    x3 = x3 * m + d;
    x4 = x4 * m + d;
    x5 = x5 * m + d;
    x6 = x6 * m + d;
    x7 = x7 * m + d;
    x8 = x8 * m + d;
    x9 = x9 * m + d;
    x10 = x10 * m + d;
    x11 = x11 * m + d;
    x12 = x12 * m + d;
    x13 = x13 * m + d;
    x14 = x14 * m + d;
    x15 = x15 * m + d;
  }
  float sum = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 + x12 + x13 + x14 + x15;
  float r = float(sum);
  if (r == 1234.0) c[gl_GlobalInvocationID.x] = r;
}
