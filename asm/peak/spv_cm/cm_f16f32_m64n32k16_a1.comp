#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly buffer F { float16_t flag[]; };
layout(std430, binding = 2) writeonly buffer C { float c[]; };
void main() {
  coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> ma;
  coopmat<float16_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseB> mb;
  coopMatLoad(ma, a, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
  coopMatLoad(mb, a, 0, 32, gl_CooperativeMatrixLayoutRowMajor);
  coopmat<float, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator> c0 = coopmat<float, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator>(0);
  for (int i = 0; i < 64; ++i) {
    c0 = coopMatMulAdd(ma, mb, c0);
    ma = ma * float16_t(1.0009765625);
  }
  if (flag[0] == float16_t(1.0)) {
    coopMatStore(c0, c, 0, 32, gl_CooperativeMatrixLayoutRowMajor);
  }
}
