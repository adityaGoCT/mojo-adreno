#version 450
// Hand-written GLSL equivalent of llama/kernels/gemv_add.mojo, for an A/B against the Mojo -> LLVM -> SPIR-V path:
// same bindings, 64 threads per row, 4 coalesced fp16 loads per step, native subgroupAdd.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer W { float16_t w[]; };
layout(std430, set = 0, binding = 1) readonly buffer X { float x[]; };
layout(std430, set = 0, binding = 2) buffer Y { float y[]; };
layout(std430, set = 0, binding = 3) readonly buffer P { uint p[]; };
void main() {
  uint r = gl_WorkGroupID.x, t = gl_LocalInvocationID.x, n = p[0];
  float acc = 0.0;
  for (uint i = 0u; i < n / 256u; ++i) {
    uint c = i * 256u + t;
    for (uint j = 0u; j < 4u; ++j) acc += float(w[r * n + c + j * 64u]) * x[c + j * 64u];
  }
  acc = subgroupAdd(acc);
  if (t == 0u) y[r] += acc;
}
