#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
// bug 2 control: the same sum element by element. Runs correctly. dispatch (1,1,1)
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer X { float16_t x[]; };
layout(std430, binding = 2) writeonly buffer Y { float16_t y[]; };
void main() {
  coopmat<float16_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator> c0, c1;
  coopMatLoad(c0, x, 0u, 32u, gl_CooperativeMatrixLayoutRowMajor);
  coopMatLoad(c1, x, 2048u, 32u, gl_CooperativeMatrixLayoutRowMajor);
  for (int e = 0; e < c0.length(); ++e) c0[e] = c0[e] + c1[e];
  coopMatStore(c0, y, 0u, 32u, gl_CooperativeMatrixLayoutRowMajor);
}
