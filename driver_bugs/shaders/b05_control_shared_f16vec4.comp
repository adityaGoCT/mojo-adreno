#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
// bug 5: global -> shared -> coopMatLoad -> global, one 64 x 16 fp16 tile (1,024 halves), control: shared array of f16vec4. Correct.
// Expected: y == x. dispatch (1,1,1)
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer X4 { uvec4 x4[]; };
layout(std430, binding = 2) writeonly buffer Y { float16_t y[]; };
shared f16vec4 sh[256];
void main() {
  uint t = gl_LocalInvocationIndex;
  for (uint i = 0u; i < 2u; ++i) { uvec4 v = x4[t * 2u + i]; uint j = (t * 2u + i) * 2u; sh[j] = f16vec4(unpackFloat2x16(v.x), unpackFloat2x16(v.y)); sh[j + 1u] = f16vec4(unpackFloat2x16(v.z), unpackFloat2x16(v.w)); }
  memoryBarrierShared(); barrier();
  coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> m;
  coopMatLoad(m, sh, 0u, 4u, gl_CooperativeMatrixLayoutRowMajor);   // row stride 16 halves, in units of the array element
  coopMatStore(m, y, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
}
