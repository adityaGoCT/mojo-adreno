#version 450
// b09_q4_elem4_const: AdrenoBLAS's Q4_0 GEMM kernel (ablas/gen_q4.py, q4_w1x1_k32) at M = N = K = 64: C = A x dequant(W)^T, where
// each lane dequantizes its own column of 4-bit weights and writes the 16 values into a 16 x 64 B matrix element by
// element (on this driver lane l = column l, element e = k). The test uses A = identity, so C[r][n] = W[n][r] exactly.
// bug 9: element 4 is written with a constant index. Expected: C exact. Observed: every C[r][n] with r % 16 == 4 is 0 (the write is dropped).
// dispatch (1, 1, 1), local size 64. Buffers: 0 = A (fp16, 64 x 16 tiles), 1 = W (Q4_0 layout of gen_q4.py), 2 = C (fp16 64 x 64).
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly buffer BQ { uvec2 bq[]; };
layout(std430, binding = 1) readonly buffer BD { float16_t bd[]; };
layout(std430, binding = 2) writeonly buffer C { float16_t c[]; };
layout(std430, binding = 2) writeonly buffer C4 { uvec4 c4[]; };
void deq(uvec2 q, float16_t d, inout coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB> b) {
  f16vec2 dd = f16vec2(d), off = f16vec2(1032.0hf);
  f16vec2 v0 = (unpackFloat2x16(((q.x >> 0u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  f16vec2 v1 = (unpackFloat2x16(((q.x >> 4u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  f16vec2 v2 = (unpackFloat2x16(((q.x >> 8u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  f16vec2 v3 = (unpackFloat2x16(((q.x >> 12u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  f16vec2 v4 = (unpackFloat2x16(((q.y >> 0u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  f16vec2 v5 = (unpackFloat2x16(((q.y >> 4u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  f16vec2 v6 = (unpackFloat2x16(((q.y >> 8u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  f16vec2 v7 = (unpackFloat2x16(((q.y >> 12u) & 0x000F000Fu) | 0x64006400u) - off) * dd;
  int z = int(gl_SubgroupInvocationID >> 8u);
  b[0] = v0.x; b[1] = v0.y; b[2] = v1.x; b[3] = v1.y; b[4] = v2.x; b[5] = v2.y; b[6] = v3.x; b[7] = v3.y; b[8] = v4.x; b[9] = v4.y; b[10] = v5.x; b[11] = v5.y; b[12] = v6.x; b[13] = v6.y; b[14] = v7.x; b[15] = v7.y;
}
void main() {
  uint sg = gl_SubgroupID, l = gl_SubgroupInvocationID;
  uint row0 = gl_WorkGroupID.y * 64u + (sg / 1u) * 64u;
  uint col0 = gl_WorkGroupID.x * 64u + (sg % 1u) * 64u;
  uint KB = 64u / 32u;
  uint qb = (col0 / 64u) * KB * 128u + l;
  uint db = 64u * 64u / 4u + (col0 / 64u) * KB * 64u + l;
  uint ab = (row0 / 64u) * (64u / 16u) * 1024u;
  coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator> acc = coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator>(0);
  for (uint kb = 0u; kb < KB; ++kb) {
    uvec2 q0 = bq[qb + kb * 128u], q1 = bq[qb + kb * 128u + 64u];
    float16_t d = bd[db + kb * 64u];
    coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> a0; coopMatLoad(a0, a, ab + kb * 2048u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> a1; coopMatLoad(a1, a, ab + kb * 2048u + 1024u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB> b0 = coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB>(0.0hf); deq(q0, d, b0);
    coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB> b1 = coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB>(0.0hf); deq(q1, d, b1);
    acc = coopMatMulAdd(a0, b0, acc);
    acc = coopMatMulAdd(a1, b1, acc);
  }
  coopMatStore(acc, c, row0 * 64u + col0, 64u, gl_CooperativeMatrixLayoutRowMajor);
}
