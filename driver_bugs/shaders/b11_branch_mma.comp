#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
// bug 11: two subgroups take alternate 64-key blocks of a loop; a subgroup whose block is past the end skips its
// multiplies (a branch that differs between the subgroups of the workgroup, uniform inside each subgroup).
// Expected: compiles. Observed: segfault in vkCreateComputePipelines (recursion in CoopMatLayoutNode::getUseCommonMask).
// dispatch (1,1,1), push constant n = number of blocks (e.g. 3)
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly buffer B { float16_t b[]; };
layout(std430, binding = 2) writeonly buffer C { float16_t c[]; };
layout(push_constant) uniform P { uint n; } pc;
shared f16vec4 sh[2 * 64 * 17];
void main() {
  uint sg = gl_SubgroupID;
  coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator> acc = coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator>(0.0hf);
  for (uint kp = 0u; 2u * kp < pc.n; ++kp) {
    uint kb = 2u * kp + sg;
    if (kb < pc.n) {                                    // differs between the two subgroups
      coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator> s = coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator>(0.0hf);
      for (uint kk = 0u; kk < 8u; ++kk) {
        coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> ma;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB> mb;
        coopMatLoad(ma, a, kk * 1024u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb, b, (kb * 8u + kk) * 1024u, 16u, gl_CooperativeMatrixLayoutColumnMajor);
        s = coopMatMulAdd(ma, mb, s);
      }
      coopMatStore(s, sh, sg * 64u * 17u, 17u, gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();
    for (uint t = 0u; t < 2u; ++t) {
      uint kt = 2u * kp + t;
      if (kt < pc.n)                                    // uniform across the workgroup
        for (uint kc = 0u; kc < 4u; ++kc) {
          coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> pa;
          coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB> vb;
          coopMatLoad(pa, sh, t * 64u * 17u + kc * 4u, 17u, gl_CooperativeMatrixLayoutRowMajor);
          coopMatLoad(vb, b, (kt * 4u + kc) * 1024u, 16u, gl_CooperativeMatrixLayoutColumnMajor);
          acc = coopMatMulAdd(pa, vb, acc);
        }
    }
    barrier();
  }
  coopMatStore(acc, c, sg * 4096u, 64u, gl_CooperativeMatrixLayoutRowMajor);
}
