#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
// bug 1 note: K unrolled by 2 into ONE 64 x 32 accumulator runs correctly; the hang needs two accumulators (b01_min_two_acc_kunroll2).
// C[M,N] = A[M,K] x B[K,N], fp16 row-major, one subgroup per 64 x 32 tile of C. M = N = K = 1024.
// dispatch (32, 16, 1), local size 64
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly buffer B { float16_t b[]; };
layout(std430, binding = 2) writeonly buffer C { float16_t c[]; };
const uint M = 1024u, N = 1024u, K = 1024u;
void main() {
  uint row0 = gl_WorkGroupID.y * 64u, col0 = gl_WorkGroupID.x * 32u;
  coopmat<float16_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator> acc = coopmat<float16_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator>(0.0hf);
  for (uint k = 0u; k < K; k += 32u) {                  // K unrolled by 2
    coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> a0, a1;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseB> b0, b1;
    coopMatLoad(a0, a, row0 * K + k, K, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(b0, b, k * N + col0, N, gl_CooperativeMatrixLayoutRowMajor);
    acc = coopMatMulAdd(a0, b0, acc);
    coopMatLoad(a1, a, row0 * K + k + 16u, K, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(b1, b, (k + 16u) * N + col0, N, gl_CooperativeMatrixLayoutRowMajor);
    acc = coopMatMulAdd(a1, b1, acc);                  // second multiply into the same accumulator: GPU hang
  }
  coopMatStore(acc, c, row0 * N + col0, N, gl_CooperativeMatrixLayoutRowMajor);
}
