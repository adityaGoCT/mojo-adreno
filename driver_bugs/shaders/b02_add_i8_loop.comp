#version 450
// b02_add_i8_loop: asm/peak/gen_coopmat_peak.py s8s32 m64n32k32 a1: 64 int8 multiplies into an int32 accumulator with
// ma = ma + ma between them. Expected: compiles. Observed: vkCreateComputePipelines returns -13 (VK_ERROR_UNKNOWN); an earlier driver build segfaulted. dispatch (2048, 1, 1), local size 128
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer A { int8_t a[]; };
layout(std430, binding = 1) readonly buffer F { float16_t flag[]; };
layout(std430, binding = 2) writeonly buffer C { int32_t c[]; };
void main() {
  coopmat<int8_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseA> ma;
  coopmat<int8_t, gl_ScopeSubgroup, 32, 32, gl_MatrixUseB> mb;
  coopMatLoad(ma, a, 0, 32, gl_CooperativeMatrixLayoutRowMajor);
  coopMatLoad(mb, a, 0, 32, gl_CooperativeMatrixLayoutRowMajor);
  coopmat<int32_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator> c0 = coopmat<int32_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator>(0);
  for (int i = 0; i < 64; ++i) {
    c0 = coopMatMulAdd(ma, mb, c0);
    ma = ma + ma;
  }
  if (flag[0] == float16_t(1.0)) {
    coopMatStore(c0, c, 0, 32, gl_CooperativeMatrixLayoutRowMajor);
  }
}
