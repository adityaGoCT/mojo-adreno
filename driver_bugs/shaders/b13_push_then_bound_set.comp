// Bug 13: push descriptors and an ordinary descriptor set in one command buffer. This shader is the push-descriptor
// dispatch: o[i] += tag * 65536 + i (the buffers start at 0), tag from the push constants. The harness records it three
// times, each time with its own output buffer pushed at binding 0 and tag 1, 2, 3, each followed by a barrier and a
// dispatch of b13_bound_set_dispatch.spv, which has its own pipeline layout and an ordinary descriptor set (the
// control, b13_control_no_bound_set, leaves those dispatches out). Expected: buffer t holds t * 65536 + i.
// Observed: buffers 1 and 2 stay 0 and buffer 3 holds 6 * 65536 + i, i.e. all three dispatches used the descriptors
// pushed last (each with its own push constants).
#version 450
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint tag; } pc;
layout(std430, binding = 0) buffer O { uint o[]; };
// += makes writes that land in another dispatch's buffer visible
void main() { o[gl_GlobalInvocationID.x] += pc.tag * 65536u + gl_GlobalInvocationID.x; }
