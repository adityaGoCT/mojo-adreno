// Kernel 12: panels. Both operands pre-packed so that every tile a cooperative load reads is one contiguous block,
// and consecutive K tiles are adjacent: A as [M/64][K/16] tiles of 64 x 16 (2 KB, column-major inside), B as
// [N/32][K/16] tiles of 16 x 32 (1 KB, row-major inside). A subgroup's K loop now walks memory sequentially.
#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
const uint M = SIZE_M, N = SIZE_N, K = SIZE_K;
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly restrict buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly restrict buffer B { float16_t b[]; };
layout(std430, binding = 2) writeonly restrict buffer C { float16_t c[]; };
#define RM gl_CooperativeMatrixLayoutRowMajor
#define CM gl_CooperativeMatrixLayoutColumnMajor

void main() {
  uint row0 = gl_WorkGroupID.y * 64u, col0 = gl_WorkGroupID.x * 32u;
  coopmat<float16_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator> acc =
      coopmat<float16_t, gl_ScopeSubgroup, 64, 32, gl_MatrixUseAccumulator>(0.0);
  uint pa = (row0 / 64u) * (K / 16u) * 1024u, pb = (col0 / 32u) * (K / 16u) * 512u;   // panel starts
  for (uint k = 0u; k < K; k += 16u) {
    coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> ma;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseB> mb;
    coopMatLoad(ma, a, pa + (k / 16u) * 1024u, 64, CM);   // one 2 KB block
    coopMatLoad(mb, b, pb + (k / 16u) * 512u, 32, RM);    // one 1 KB block
    acc = coopMatMulAdd(ma, mb, acc);
  }
  coopMatStore(acc, c, row0 * N + col0, N, RM);
}
