// Kernel 3: kernel 2 with the inputs declared readonly (and restrict). The source change is two words; it lets
// the compiler fetch A and B through the read-only (texture) path instead of the read-write path.
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
const uint M = SIZE_M, N = SIZE_N, K = SIZE_K;
layout(local_size_x = 64, local_size_y = 4) in;
layout(std430, binding = 0) readonly restrict buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly restrict buffer B { float16_t b[]; };
layout(std430, binding = 2) writeonly restrict buffer C { float16_t c[]; };

void main() {
  uint col = gl_GlobalInvocationID.x, row = gl_GlobalInvocationID.y;
  float acc = 0.0;
  for (uint k = 0u; k < K; ++k) acc += float(a[row * K + k]) * float(b[k * N + col]);
  c[row * N + col] = float16_t(acc);
}
