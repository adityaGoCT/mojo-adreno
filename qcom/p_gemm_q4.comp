// llama/kernels/prefill/p_gemm_q4 with VK_QCOM_cooperative_matrix_conversion (Vulkan 1.4.342): a
// drop-in replacement (same bindings, params and grid) for drivers that have it. W int4 as gemv_q4
// reads it: row r, 8 weights a 32-bit word (low nibble first, signed -8..7), an fp16 scale per 64 of a
// row. As qcom/p_gemm_t2.comp, lane i building column i of B from two words of row i of W; the fp16
// products of each 64 k are scaled per column and folded into fp32 rows of Y.
#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_QCOM_cooperative_matrix_conversion : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer WQ { uint wq[]; };
layout(std430, binding = 1) readonly buffer WS { float16_t ws[]; };
layout(std430, binding = 2) readonly buffer X { float x[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };
layout(std430, binding = 4) readonly buffer P { uint p[]; };  // 64-bit slots: n, k

void main() {
  uint n = p[0], k = p[2];
  uint sg = gl_LocalInvocationID.x / 64, lane = gl_LocalInvocationID.x % 64;
  uint row = gl_WorkGroupID.y * 128 + (sg / 2) * 64 + lane;
  uint col0 = gl_WorkGroupID.x * 128 + (sg % 2) * 64;
  float acc[64];
  for (int c = 0; c < 64; ++c) acc[c] = 0.0;
  for (uint g = 0; g < k / 64; ++g) {
    coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator> part =
        coopmat<float16_t, gl_ScopeSubgroup, 64, 64, gl_MatrixUseAccumulator>(float16_t(0.0));
    for (uint kk = 0; kk < 64; kk += 16) {
      uint k0 = g * 64 + kk;
      float16_t av[16], bv[16];
      for (int j = 0; j < 16; ++j) av[j] = float16_t(x[row * k + k0 + j]);
      for (int h = 0; h < 2; ++h) {
        uint word = wq[(col0 + lane) * (k / 8) + k0 / 8 + h];
        for (int j = 0; j < 8; ++j) bv[h * 8 + j] = float16_t(float(int((word >> (4 * j)) & 15u ^ 8u) - 8));
      }
      coopmat<float16_t, gl_ScopeSubgroup, 64, 16, gl_MatrixUseA> a;
      coopmat<float16_t, gl_ScopeSubgroup, 16, 64, gl_MatrixUseB> b;
      vectorToCoopmatQCOM(av, a);
      vectorToCoopmatQCOM(bv, b);
      part = coopMatMulAdd(a, b, part);
    }
    float16_t pv[64];
    coopmatToVectorQCOM(part, pv);
    for (int c = 0; c < 64; ++c) acc[c] += float(pv[c]) * float(ws[(col0 + c) * (k / 64) + g]);
  }
  for (int c = 0; c < 64; ++c) y[row * n + col0 + c] = acc[c];
}
